# The documented key list for the runtime environment. Values here are always
# blank — this file is a manifest, not a template to fill in.
#
# Real values live encrypted in secrets/secrets.enc.env and are decrypted into
# .env by `make run` / `tilt up`. Do not hand-write .env; it gets overwritten.
#   make secrets-edit    change a value
#   make secrets-check   verify this file and the vault still agree
# See docs/secrets.md.
#
# Adding a secret means adding its key here too: CI fails on a vault key that
# isn't documented in this file, and this list is the recovery checklist if
# every age key is ever lost.
#
# Non-secret backend defaults live in backend/src/main/resources/application*.yaml.

# Postgres/Grafana credentials. Compose turns POSTGRES_DB into POSTGRES_URL
# for Ktor-native full-value env substitution.
POSTGRES_DB=roadtrip
POSTGRES_USER=roadtrip
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_DB_PASSWORD=

# Observability knobs read by docker-compose.yml. All have working defaults —
# set them only to override.
#   PROMETHEUS_RETENTION           metric retention (default 14d). Log and trace
#                                  retention is 168h, set in
#                                  grafana/loki/loki-config.yml and
#                                  grafana/tempo/tempo.yml (not env-driven).
#   OTEL_TRACES_SAMPLER_ARG        trace sample ratio (default 1.0 — every
#                                  request). Lower it if trace volume outgrows
#                                  Tempo's disk.
#   OTEL_SERVICE_NAME              service.name on all backend telemetry
#                                  (default roadtrip-backend).
#   OTEL_EXPORTER_OTLP_ENDPOINT    where the Java agent ships to (default
#                                  http://alloy:4317).
#   OTEL_METRICS_EXPORTER          set to `none` to mute metrics without
#                                  restarting the whole pipeline.
#   GRAFANA_DASHBOARD_ALLOW_UI_UPDATES  `true` persists Grafana UI dashboard
#                                  edits in its DB instead of reconciling from
#                                  grafana/dashboards/*.json. Local only.
PROMETHEUS_RETENTION=
OTEL_TRACES_SAMPLER_ARG=

# Cloudflare tunnel token for remote access via docker-compose (see README.md).
CLOUDFLARE_TUNNEL_TOKEN=

# OIDC identity provider (RFC 0009). Leave issuer/client-id blank to run with
# auth disabled. `provider` picks a claims dialect: auth0 | workos | oidc.
#
# Auth0 setup: Applications -> Create Application -> Regular Web Application.
# Not a SPA: this is a confidential client doing a server-side code exchange,
# and a public client has no secret to sign the flow cookie with. Copy Domain
# (prefixed with https://), Client ID, and Client Secret from its Settings tab.
#
# On that same Settings tab, for local `tilt up`:
#   Allowed Callback URLs   http://127.0.0.1:8765/auth/callback
#   Allowed Logout URLs     http://127.0.0.1:8765
# The redirect URI is derived from roadtrip.web.root-url, which is 127.0.0.1 —
# and Auth0 treats 127.0.0.1 and localhost as different origins, so browse to
# 127.0.0.1 or the callback is rejected as a mismatch.
ROADTRIP_AUTH_PROVIDER=auth0
ROADTRIP_AUTH_ISSUER=
ROADTRIP_AUTH_CLIENT_ID=
ROADTRIP_AUTH_CLIENT_SECRET=

# Mapbox API token (server-side only; used by /api/route and /api/geocode).
MAPBOX_TOKEN=

# Campsite/vendor API secrets.
RIDB_API_KEY=
CAMPFLARE_API_KEY=

# Not vaulted: TESLA_COOKIES. Akamai binds _abck to the egress IP that minted
# it, so the value is per-machine and short-lived by nature — sharing one
# encrypted copy across hosts would hand every host a cookie that only works
# from one of them. `scripts/refresh-tesla-cookies.sh` mints it into .env.local
# instead (host-local, gitignored, merged into .env). scripts/tesla_client.py
# still reads TESLA_COOKIES from the environment as its cookie-bot fallback.

# Slack alerts and interactivity.
SLACK_BOT_TOKEN=
SLACK_ALERT_CHANNEL=
SLACK_SIGNING_SECRET=
GRAFANA_SLACK_WEBHOOK_URL=

# Resend email alerts.
RESEND_API_KEY=

# Cookie-bot sidecar token, used only when the cookie-bot profile is enabled.
COOKIE_BOT_TOKEN=
