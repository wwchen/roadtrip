# Host-local, non-secret overrides. Copy to .env.local if you need any.
#
# Runtime secrets are NOT here any more. They live encrypted in secrets/, are
# declared in secrets/registry.yaml, and are mounted into containers at
# /run/secrets by docker-compose.secrets.yml. See docs/secrets.md.
#
#   ./secrets/manage.py ls        what exists and where it is set
#   ./secrets/manage.py set NAME  change a value
#
# Non-secret tunables (OTEL_*, PROMETHEUS_RETENTION, COMPANION_*, GRAFANA_*_USER)
# keep their defaults in docker-compose.yml; override them per host in .env.local
# rather than listing them here, so this file cannot drift back into a second
# copy of the secret list.

# Tesla pricing cookies. Deliberately outside the vault: Akamai binds _abck to
# the egress IP that minted it, so a shared copy only works from one machine.
# To mint: open tesla.com/findus, click a Supercharger, then DevTools ->
# Network -> get-charger-details -> copy the Cookie header value into
# TESLA_COOKIES= in .env.local on this machine.
TESLA_COOKIES=
