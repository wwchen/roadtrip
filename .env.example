# Optional local/deploy secrets and host credentials.
# Non-secret backend defaults live in backend/src/main/resources/application*.yml.

# Postgres/Grafana credentials. Backend application-prod.yml reads
# POSTGRES_* through ${...} placeholders.
POSTGRES_DB=roadtrip
POSTGRES_USER=roadtrip
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_DB_PASSWORD=

# Cloudflare tunnel token for remote access via docker-compose (see README.md).
CLOUDFLARE_TUNNEL_TOKEN=

# Mapbox API token (server-side only; used by /api/route and /api/geocode).
MAPBOX_TOKEN=

# Campsite/vendor API secrets.
RIDB_API_KEY=
CAMPFLARE_API_KEY=
TESLA_COOKIES=

# Optional Recreation.gov companion login. These are consumed only by the
# companion process/container. Backend config does not read them.
RECGOV_EMAIL=
RECGOV_PASSWORD=
# Set this only for the run where Recreation.gov asks for 2FA.
RECGOV_MFA_CODE=

# Slack alerts and interactivity.
SLACK_BOT_TOKEN=
SLACK_ALERT_CHANNEL=
SLACK_SIGNING_SECRET=
GRAFANA_SLACK_WEBHOOK_URL=

# Cookie-bot sidecar token, used only when the cookie-bot profile is enabled.
COOKIE_BOT_TOKEN=
