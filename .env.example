# Optional local/deploy secrets and host credentials.
# Non-secret backend defaults live in backend/src/main/resources/application*.yaml.

# Postgres/Grafana credentials. Compose turns POSTGRES_DB into POSTGRES_URL
# for Ktor-native full-value env substitution.
POSTGRES_DB=roadtrip
POSTGRES_USER=roadtrip
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_DB_PASSWORD=

# Observability knobs read by docker-compose.yml. All have working defaults —
# set them only to override.
#   PROMETHEUS_RETENTION           metric retention (default 14d). Log and trace
#                                  retention is 168h, set in
#                                  grafana/loki/loki-config.yml and
#                                  grafana/tempo/tempo.yml (not env-driven).
#   OTEL_TRACES_SAMPLER_ARG        trace sample ratio (default 1.0 — every
#                                  request). Lower it if trace volume outgrows
#                                  Tempo's disk.
#   OTEL_SERVICE_NAME              service.name on all backend telemetry
#                                  (default roadtrip-backend).
#   OTEL_EXPORTER_OTLP_ENDPOINT    where the Java agent ships to (default
#                                  http://alloy:4317).
#   OTEL_METRICS_EXPORTER          set to `none` to mute metrics without
#                                  restarting the whole pipeline.
#   GRAFANA_DASHBOARD_ALLOW_UI_UPDATES  `true` persists Grafana UI dashboard
#                                  edits in its DB instead of reconciling from
#                                  grafana/dashboards/*.json. Local only.
PROMETHEUS_RETENTION=
OTEL_TRACES_SAMPLER_ARG=

# Cloudflare tunnel token for remote access via docker-compose (see README.md).
CLOUDFLARE_TUNNEL_TOKEN=

# OIDC identity provider (RFC 0009). Leave issuer/client-id blank to run with
# auth disabled. `provider` picks a claims dialect: auth0 | workos | oidc.
ROADTRIP_AUTH_PROVIDER=auth0
ROADTRIP_AUTH_ISSUER=
ROADTRIP_AUTH_CLIENT_ID=
ROADTRIP_AUTH_CLIENT_SECRET=

# Mapbox API token (server-side only; used by /api/route and /api/geocode).
MAPBOX_TOKEN=

# Campsite/vendor API secrets.
RIDB_API_KEY=
CAMPFLARE_API_KEY=
TESLA_COOKIES=

# Slack alerts and interactivity.
SLACK_BOT_TOKEN=
SLACK_ALERT_CHANNEL=
SLACK_SIGNING_SECRET=
GRAFANA_SLACK_WEBHOOK_URL=

# Resend email alerts.
RESEND_API_KEY=

# Cookie-bot sidecar token, used only when the cookie-bot profile is enabled.
COOKIE_BOT_TOKEN=
