#!/usr/bin/env bash
# Run Kotlin static checks against staged Kotlin/config files. Skip entirely
# if none are staged so non-backend commits are unaffected. Enable with
# `make install-hooks`.
set -euo pipefail

# Secrets guard. Runs on every commit regardless of what's staged: the failure
# it prevents (a credential in git history) cannot be undone by a later commit.
if git diff --cached --name-only --diff-filter=ACMR |
     grep -qE '^\.env$|^\.env\.local$'; then
  echo "refusing to commit a plaintext .env — it holds real credentials."
  echo "Secrets belong in the vault: ./secrets/manage.py set <NAME>"
  exit 1
fi

# Dead-branch guard. Committing onto a branch whose PR is already merged or
# closed produces work that cannot land: the PR will never pick it up, and the
# branch is deleted on merge. Nothing errors at the time, so it is discovered
# hours later, which is exactly how work gets lost — most often by an agent that
# resumed an old worktree without checking what happened to its PR.
#
# Matching the branch *name* is not enough, because names get reused. Deleting a
# merged branch and starting fresh work under the same name is normal, and those
# commits land fine under a new PR. What condemns a branch is still carrying the
# finished PR's commits. This repo squash- and rebase-merges only (merge commits
# are disabled), so a merged PR's head SHA never appears on master and a branch
# recreated from master cannot reach it — reachability separates the two cases
# exactly. The base-branch test below covers the dozen legacy merge commits in
# this repo's early history, where the head SHA *did* land on master and
# reachability alone would condemn every branch later cut from it.
#
# Deliberately fails *open*. No gh, not authenticated, offline, rate-limited, no
# remote, no PR for this branch, or a head SHA no longer in the local object
# database all look the same from here, and none of them justify blocking a
# commit. Only an unambiguous "a finished PR's commits are still under us" blocks.
#
# Costs one API call per commit on a named non-default branch. That is the
# price of catching the transition — a cached "alive" verdict would miss the
# merge it exists to notice, and a cached "dead" one would wrongly block a
# reopened PR.
#
# Detached HEAD (rebase, bisect, cherry-pick) yields an empty $branch and is
# skipped: there is no branch to have a PR.
branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)
if [ "${ALLOW_DEAD_BRANCH:-}" != "1" ] &&
   [ -n "$branch" ] &&
   [ "$branch" != "master" ] && [ "$branch" != "main" ] &&
   command -v gh >/dev/null 2>&1; then
  gh_timeout=""
  command -v timeout >/dev/null 2>&1 && gh_timeout="timeout 10"
  # TSV keeps each PR's state paired with its head SHA. gh's --jq is built in,
  # so this needs no system jq.
  pr_rows=$(
    $gh_timeout gh pr list --head "$branch" --state all --limit 10 \
      --json number,state,headRefOid,baseRefName \
      --jq '.[] | [.number, .state, .headRefOid, .baseRefName] | @tsv' 2>/dev/null || true
  )
  # An OPEN PR means the branch is live even if an earlier PR from the same head
  # was closed — #497/#500 style supersession leaves both on record.
  if [ -n "$pr_rows" ] && ! printf '%s\n' "$pr_rows" | cut -f2 | grep -qx OPEN; then
    dead_prs=""
    while IFS=$'\t' read -r pr_number pr_state pr_head pr_base; do
      [ -n "${pr_head:-}" ] || continue
      # Not in our history: either a branch reusing the name, or a SHA we no
      # longer have locally. Committing on top of neither loses anything.
      git merge-base --is-ancestor "$pr_head" HEAD 2>/dev/null || continue
      # Reachable only because it already landed on the base branch, which every
      # branch cut from that base inherits. Says nothing about this branch.
      if git rev-parse --verify --quiet "origin/$pr_base" >/dev/null 2>&1 &&
         git merge-base --is-ancestor "$pr_head" "origin/$pr_base" 2>/dev/null; then
        continue
      fi
      dead_prs="${dead_prs}  PR #${pr_number} is ${pr_state} — its commit ${pr_head:0:7} is still in this branch"$'\n'
    done <<EOF
$pr_rows
EOF
    if [ -n "$dead_prs" ]; then
      echo "refusing to commit on '$branch' — its pull request is already finished."
      printf '%s' "$dead_prs"
      echo
      echo "Commits here cannot land. Move the work to a fresh branch:"
      echo "    git switch -c <new-branch> origin/master"
      echo "    git cherry-pick <sha>          # if you already committed here"
      echo
      echo "To keep using this name for new work, put it back on master first:"
      echo "    git switch -C $branch origin/master   # drops the commits listed above"
      echo
      echo "If the PR is being reopened, or you are amending before the branch is"
      echo "deleted:  ALLOW_DEAD_BRANCH=1 git commit ..."
      exit 1
    fi
  fi
fi

# Validate whenever the secrets system itself is touched. --staged checks the
# blob entering history rather than the worktree, and this also catches a
# registry edit committed without regenerating docker-compose.secrets.yml.
if git diff --cached --name-only --diff-filter=ACMR |
     grep -qE '^secrets/|^docker-compose\.secrets\.yml$'; then
  if ! python3 secrets/manage.py check --staged; then
    echo
    echo "secrets check failed — see above."
    exit 1
  fi
fi

staged=$(
  git diff --cached --name-only --diff-filter=ACMR |
    grep -E '^backend/.*\.kts?$|^detekt-rules/.*\.kts?$|^config/detekt/|(^|/)build\.gradle\.kts$|^settings\.gradle\.kts$' ||
    true
)
[ -z "$staged" ] && exit 0

if ! ./gradlew --quiet :backend:ktlintCheck -x :backend:generateJooq; then
  echo
  echo "ktlint failed. Auto-fix with: ./gradlew :backend:ktlintFormat -x :backend:generateJooq"
  exit 1
fi

if ! ./gradlew --quiet :backend:detekt; then
  echo
  echo "detekt failed. Run locally with: ./gradlew :backend:detekt"
  exit 1
fi
