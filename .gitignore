.env
.env.*
!.env.example
samples/
node_modules/
.DS_Store
__pycache__/
*.pyc
.gstack/
.worktrees/
.claude/worktrees/

# Backend (Kotlin) build artifacts. jOOQ generated classes are regenerated
# at build time via Testcontainers + Flyway, so they don't need to be checked in.
.gradle/
.kotlin/
build/
backend/.gradle/
backend/.kotlin/
backend/build/

# Playwright smoke artifacts. Tests live in qa/, deps + browser cache + run
# results all stay local.
qa/test-results/
qa/playwright-report/

.idea/
.obsidian/

# Generated from tracked raw captures.
data/etl-out/

# Brainstorming visual companion
.superpowers/

# Per-sandbox Caddy vhost snippets are generated at runtime by deploy.sh;
# only caddy/sandboxes/.gitkeep is tracked (keeps the bind-mount dir present).
caddy/sandboxes/*.caddy
