{
  "name": "campsite-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../.env --experimental-eventsource src/index.js",
    "serve": "node --env-file-if-exists=../.env src/server.js",
    "recgov:login": "node --env-file-if-exists=../.env src/checkRecgovAuth.js",
    "recgov:refresh": "node --env-file-if-exists=../.env src/checkRecgovAuth.js --force-refresh",
    "recgov:atc": "node --env-file-if-exists=../.env src/runAtcOnce.js",
    "spike:client": "node spike/client.js",
    "spike:test": "node --test spike/test.js",
    "test": "node --test 'test/*.test.js'"
  },
  "dependencies": {
    "playwright": "^1.49.0"
  }
}
