, "capacityCategoryId": -32767, "allocatePerBooking": false, "secondaryCapacityCategoryId": null, "maxEquipmentToPeopleRatio": null}, "nonSiteSpecificSettings": null, "linkedResources": [], "localizedValues": [{"cultureName": "en-CA", "name": "8:30 a.m. Bus", "description": "This bus takes visitors 11 km up to Lake O’Hara to enjoy the recreational activities, hiking trails, backcountry campsites and partner offers that exist. Reservations are required for in-bound travel and are open to day use visitors at either 8:30 a.m. or 10:30 a.m. MDT. Return out-bound bus transportation is available at 9:30 a.m., 11:30 a.m., 2:30 p.m., 4:30 p.m. and 6:30 p.m. **MDT. Reservations are not required for the return out-bound bus."}, {"cultureName": "fr-CA", "name": "8 h 30 Navette", "description": "Cette navette amène les visiteurs sur une distance de 11 km jusqu'au lac O’Hara, où ils peuvent profiter des activités récréatives, des sentiers de randonnée, des emplacements de camping dans l'arrière-pays ainsi que des offres de nos partenaires, tout en se trouvant parmi la beauté de la nature. Il est nécessaire de faire des réservations pour le trajet de départ ; les réservations sont ouvertes aux utilisateurs diurnes soit à 8 h 30, soit à 10 h 30 HAR. Les trajets de retour sont disponibles à 9 h 30, 11 h 30, 14 h 30 et 18 h 30 ** HAR. Il n'est pas nécessaire de faire une réservation pour le trajet de retour."}], "allowedEquipment": [], "reservableTransactionLocationIds": [-2147483644, -2147483629, -2147483605, -2147483603], "order": 10, "maxStay": 1, "maxStayIsAggregate": true, "maxAdultCapacity": null, "minCapacity": null, "maxCapacity": 6, "minBoatLength": null, "maxBoatLength": null, "maxBoatDraft": null, "slipWidth": null, "customAttributes": [], "definedAttributes": [{"attributeDefinitionId": -32719, "attributeId": -2147397390, "attributeVisibility": 0, "value": null, "values": [1]}, {"attributeDefinitionId": -32768, "attributeId": -2147397389, "attributeVisibility": 0, "value"