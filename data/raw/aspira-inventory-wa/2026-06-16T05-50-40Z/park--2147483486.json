.com/images/e95ecaab-d968-4ebe-87b3-4d60e497ff00.avif", "url": "https://washington.goingtocamp.com/images/e95ecaab-d968-4ebe-87b3-4d60e497ff00.jpg"}, "aspectType": 0}, {"photoUrlResult": {"avifUrl": "https://washington.goingtocamp.com/images/ef142140-2392-48ae-b7c7-2f9d3804003e.avif", "url": "https://washington.goingtocamp.com/images/ef142140-2392-48ae-b7c7-2f9d3804003e.jpg"}, "aspectType": 0}, {"photoUrlResult": {"avifUrl": "https://washington.goingtocamp.com/images/b481ee06-7c25-496d-9e85-9cd886a8dac4.avif", "url": "https://washington.goingtocamp.com/images/b481ee06-7c25-496d-9e85-9cd886a8dac4.jpg"}, "aspectType": 0}, {"photoUrlResult": {"avifUrl": "https://washington.goingtocamp.com/images/00b902ff-d2d9-404c-87b3-6d139a63c629.avif", "url": "https://washington.goingtocamp.com/images/00b902ff-d2d9-404c-87b3-6d139a63c629.jpg"}, "aspectType": 0}], "mapIds": [-2147483286]}, "-2147475982": {"resourceId": -2147475982, "resourceLocationId": -2147483486, "resourceCategoryId": -2147483632, "feeScheduleId": -32438, "dateScheduleId": -2147483197, "dateScheduleOverrides": [], "resourceModel": 0, "zoneCapacitySettings": null, "nonSiteSpecificSettings": null, "linkedResources": [], "localizedValues": [{"cultureName": "en-US", "name": "Camp Richmond", "description": "<b>Please check availability online.  To make a reservation, please obtain a reservation request form at <a href=\"https://parks.wa.gov/find-activities/retreat-centers\">https://parks.wa.gov/find-activities/retreat-centers</a> and email it to <a href=\"Retreat.Centers@parks.wa.gov\">Retreat.Centers@parks.wa.gov</a></b>\r\n<br>\r\nCamp Richmond Retreat Center can sleep up to 52 people dormitory style and has a fully equipped kitchen with dining area. A second sleeping dorm that can accommodate up 60 people may be available to bring sleeping capacity up to 112. Pots, pans, dishes, utensils, and cleaning supplies are provided. Bring your own bedding, pillows, and towels as linens are not provided."}], "allowedEquipment": [], "reservableTransactionLocationIds": [-2147483553], "order": 20, "maxStay": null, "maxStayIsAggregate": null, "maxAdultCapacity": null, "minCapacity": 1, "maxCapacity": 52, "minBoatLength": null, "maxBoatLength": null, "maxBoatDraft": null, "slipWidth": null, "customAttributes": [], "definedAttributes": [{"attributeDefinitionId": -32759, "attributeId": -2147255228, "attributeVisibility": 0, "value": null, "values": [1]}, {"attributeDefinitionId": -32708, "attributeId": -2147255227, "attributeVisibility": 0, "value": null, "values": [1]}, {"attributeDefinitionId": -32760, "attributeId": -2147244624, "attributeVisibility": 0, "value": null, "values": [1]}], "photos": [{"photoUrlResult": {"avifUrl": "https://washington.goingtocamp.com/images/648c5227-0eff-406a-a9da-51e521a7b7fc.avif", "url": "https://washington.goingtocamp.com/images/648c5227-0eff-406a-a9da-51e521a7b7fc.jpg"}, "aspectType": 0}, {"photoUrlResult": {"avifUrl": "https://washington.goingtocamp.com/images/7180467f-30f6-4ebe-99c0-d211905114e3.avif", "url": "https://washington.goingtocamp.com/images/7180467f-30f6-4ebe-99c0-d211905114e3.jpg"}, "aspectType": 0}, {"photoUrlResult": {"avifUrl": "https://washington.goingtocamp.com/images/caf10718-05f4-4368-9dab-c1761536d60a.avif", "url": "https://washington.goingtocamp.com/images/caf10718-05f4-4368-9dab-c1761536d60a.jpg"}, "aspectType": 0}], "mapIds": [-2147483286]}, "-2147475981": {"resourceId": -2147475981, "resourceLocationId": -2147483486, "resourceCategoryId": -2147483632, "feeScheduleId": -32437, "dateScheduleId": -2147483197, "dateScheduleOverrides": [], "resourceModel": 0, "zoneCapacitySettings": null, "nonSiteSpecificSettings": null, "linkedResources": [], "localizedValues": [{"cultureName": "en-US", "name": "Camp Wilson", "description": "<b>Please check availability online.  To make a reservation, please obtain a reservation request form at <a href=\"https://parks.wa.gov/find-activities/retreat-centers\">https://parks.wa.gov/find-activities/retreat-centers</a> and email it to <a href=\"Retreat.Centers@parks.wa.gov\">Retreat.Centers@parks.wa.gov</a></b>\r\n<br>\r\nCamp Wilson Retreat Center has two rental options depending on the size of your group. The Camp Wilson Full Camp can sleep up to 37 people and has the main building with fully equipped kitchen, dining area, and sleeping accommodations, a second building for sleeping, and a small recreation hall. The Camp Wilson Partial Camp can sleep up to 22 people and has  the main building with fully equipped kitchen, dining area, and sleeping accommodations and the small recreation hall. Pots, pans, dishes, utensils, and cleaning supplies are provided. Bring your own bedding, pillows, and towels as linens are not provided."}], "allowedEquipment": [], "reservableTransactionLocationIds": [-2147483553], "order": 30, "maxStay": null, "maxStayIsAggregate": null, "maxAdultCapacity": null, "minCapacity": 1, "maxCapacity": 22, "minBoatLength": null, "maxBoatLength": null, "maxBoatDraft": null, "slipWidth": null, "customAttributes": [], "definedAttributes": [{"attributeDefinitionId": -32759, "attributeId": -2147255226, "attributeVisibility": 0, "value": null, "values": [1]}, {"attributeDefinitionId": -32708, "attributeId": -2147255225, "attributeVisibility": 0, "value": null, "values": [1]}, {"attributeDefinitionId": -32760, "attributeId": -2147244623, "attributeVisibility": 0, "value": null, "values": [1]}], "photos": [{"photoUrlResult": {"avifUrl": "https://washington.goingtocamp.com/images/2451a95a-aae8-4886-93ce-7cd5f28a4883.avif", "url": "https://washington.goingtocamp.com/images/2451a95a-aae8-4886-93ce-7cd5f28a4883.jpg"}, "aspectType": 0}, {"photoUrlResult": {"avifUrl": "https://washington.goingtocamp.com/images/3e1721b1-ecd3-4bdf-8e67-2359a59561d4.avif", "url": "https://washington.goingtocamp.com/images/3e1721b1-ecd3-4bdf-8e67-2359a59561d4.jpg"}, "aspectType": 0}, {"photoUrlResult": {"avifUrl": "https://washington.goingtocamp.com/images/29b2c538-05c0-4c66-a1e3-cdae