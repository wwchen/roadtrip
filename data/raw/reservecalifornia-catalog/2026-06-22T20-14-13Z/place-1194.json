ltZoom": 13, "IsReservationDrawActive": false}, {"PlaceId": 670, "Name": "Malibu Creek SP", "Description": "The park has over 4,000 acres and 15 miles of trails with a creek, rock pool, lake, chaparrals and many trees. Visitors can enjoy hiking, biking, swimming, and fishing. The park was home to Native American’s for centuries and used for filming hits such as Planet of the Apes and M*A*S*H.", "HasAlerts": true, "IsFavourite": false, "Allhighlights": "Bicycling<br>Birdwatching<br>Boating<br>Camping<br>Fishing<br>Group Camping<br>Hiking<br>Horseback riding<br>Picnic area<br>Swimming<br>Visitor Center<br>", "Url": "http://www.parks.ca.gov/?page_id=614", "ImageUrl": "https://cali-content.usedirect.com/Images/California/ParkImages/Place/670.jpg", "BannerUrl": null, "ParkSize": "Medium", "Latitude": 34.10077346, "Longitude": -118.7113421, "TimeZone": "America/Los_Angeles", "TimeStamp": "2026-06-22 13:16:05", "MilesFromSelected": 97, "Available": true, "AvailableFiltered": true, "ParkCategoryId": 1, "ParkActivity": 3, "ParkPopularity": 0, "AvailableUnitCount": 1, "PartialAvailable": false, "Restrictions": {"FutureBookingStarts": "2026-06-22T00:00:00-07:00", "FutureBookingEnds": "2026-12-22T00:00:00-08:00", "MinimumStay": 1, "MaximumStay": 7, "IsRestrictionValid": true, "Time": "0001-01-01T00:00:00"}, "Facilities": {}, "IsAvailableForGreatwalk": false, "IsReservationAnyDrawActive": true, "FacilityDefaultZoom": 13, "IsReservationDrawActive": true}, {"PlaceId": 627, "Name": "Chino Hills SP", "Description": "Chino Hills State Park is a premier open-space area in the hills around the Santa Ana Canyon and is a critical link in the Puente-Chino Hills biological corridor.  The park's 14,100 acres of rolling, grassy hills and valleys are dotted with stands of oaks and sycamores and a place where people can find peace and solitude in a natural setting.  Recreational opportunities include hiking, mountain biking, or horseback riding on over 90 miles of trails, or a visit to the historic Rolling M Ranch barn.  Visitors can also enjoy a trip to the Discovery Center, featuring exhibits on wildlife and biological diversity and an accessible nature trail.\n\nPark Closure - The park will close for at least 48 hours following rain of more than one quarter inch. High clay content in the soil causes “greased” trails and roads. Use during this time makes hiking, bicycling and equestrian activities hazardous and causes severe rutting of trail and road surfaces. The park is also closed during times of extreme fire danger, when the National Weather Service announces a Red Flag Warning.", "HasAlerts": true, "IsFavourite": false, "Allhighlights": "Bicycling<br>Birdwatching<br>Camping<br>Group Camping<br>Hiking<br>Horseback riding<br>Museum<br>Picnic area<br>Visitor Center<br>", "Url": "http://www.parks.ca.gov/?page_id=648", "ImageUrl": "https://cali-content.usedirect.com/Images/California/ParkImages/Place/627.jpg", "BannerUrl": null, "ParkSize": "Medium", "Latitude": 33.95454688, "Longitude": -117.7024461, "TimeZone": "America/Los_Angeles", "TimeStamp": "2026-06-22 13:16:05", "MilesFromSelected": 99, "Available": true, "AvailableFiltered": true, "ParkCategoryId": 1, "ParkActivity": 3, "ParkPopularity": 0, "AvailableUnitCount": 14, "PartialAvailable": false, "Restrictions": {"FutureBookingStarts": "2026-06-22T00:00:00-07:00", "FutureBookingEnds": "2026-12-22T00:00:00-08:00", "MinimumStay": 1, "MaximumStay": 14, "IsRestrictionValid": true, "Time": "0001-01-01T00:00:00"}, "Facilities": {}, "IsAvailableForGreatwalk": false, "IsReservationAnyDrawActive": true, "FacilityDefaultZoom": 13, "IsReservationDrawActive": false}]}, "part": "place-1194"}