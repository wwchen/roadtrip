ultZoom": 13, "IsReservationDrawActive": false}, "NearbyPlaces": [{"PlaceId": 702, "Name": "Saddleback Butte SP", "Description": "Saddleback Butte State Park was established in 1960 to preserve its high-desert Joshua tree woodland. To the east of the campground and picnic area rises 3,651-foot Saddleback Butte. Key park attractions are the short self-guided Dic Dowen Nature Trail, the Peak Trail climbing 1,000 feet to a dramatic view across the Western Mojave Desert, a Visitor Center featuring natural and cultural history displays, and the unique Joshua Tree/Creosote habitat found only in the Mojave Desert. Springtime brings a show of wildflowers that varies yearly, and fall has clear skies and pleasant temperatures. Summer days are hot but nights are warm with excellent stargazing. Wildlife includes Mountain Bluebirds, Kit Foxes, and the federally-threatened Desert Tortoise.", "HasAlerts": false, "IsFavourite": false, "Allhighlights": "Birdwatching<br>Camping<br>Group Camping<br>Hiking<br>Horseback riding<br>Picnic area<br>Visitor Center<br>", "Url": "http://www.parks.ca.gov/?page_id=618", "ImageUrl": "https://cali-content.usedirect.com/Images/California/ParkImages/Place/702.jpg", "BannerUrl": null, "ParkSize": "Medium", "Latitude": 34.67777778, "Longitude": -117.8041667, "TimeZone": "America/Los_Angeles", "TimeStamp": "2026-06-22 13:16:05", "MilesFromSelected": 49, "Available": false, "AvailableFiltered": true, "ParkCategoryId": 1, "ParkActivity": 3, "ParkPopularity": 0, "AvailableUnitCount": 0, "PartialAvailable": false, "Restrictions": {"FutureBookingStarts": "2026-06-24T00:00:00-07:00", "FutureBookingEnds": "2026-12-22T00:00:00-08:00", "MinimumStay": 1, "MaximumStay": 30, "IsRestrictionValid": false, "Time": "0001-01-01T00:00:00"}, "Facilities": {}, "IsAvailableForGreatwalk": false, "IsReservationAnyDrawActive": true, "FacilityDefaultZoom": 13, "IsReservationDrawActive": false}, {"PlaceId": 644, "Name": "Fort Tejon SHP", "Description": "Fort Tejon State Historic Park is the site of a fort established by the U.S. Army in 1854. The post is one of the significant remaining links to the early American occupation period of California. The fort was designed to protect Native Americans living on the Sebastian Indian Reservation.  There a restored adobes from the original fort and the park's museum features exhibon army life and local history. The park also has a number of beautiful 400 year-old valley oak trees. The site also has living history events held by volunteers in costume.", "HasAlerts": false, "IsFavourite": false, "Allhighlights": "Bicycling<br>Birdwatching<br>Camping<br>Group Camping<br>Hiking<br>Horseback riding<br>Picnic area<br>Visitor Center<br>", "Url": "http://www.parks.ca.gov/?page_id=585", "ImageUrl": "https://cali-content.usedirect.com/Images/California/ParkImages/Place/644.jpg", "BannerUrl": null, "ParkSize": "Medium", "Latitude": 34.87480491, "Longitude": -118.8930124, "TimeZone": "America/Los_Angeles", "TimeStamp": "2026-06-22 13:16:05", "MilesFromSelected": 62, "Available": false, "AvailableFiltered": true, "ParkCategoryId": 3, "ParkActivity": 3, "ParkPopularity": 0, "AvailableUnitCount": 0, "PartialAvailable": false, "Restrictions": {"FutureBookingStarts": "2026-06-24T00:00:00-07:00", "FutureBookingEnds": "2026-12-22T00:00:00-08:00", "MinimumStay": 1, "MaximumStay": 30, "IsRestrictionValid": false, "Time": "0001-01-01T00:00:00"}, "Facilities": {}, "IsAvailableForGreatwalk": false, "IsReservationAnyDrawActive": true, "FacilityDefaultZoom": 13, "IsReservationDrawActive": false}, {"PlaceId": 1138, "Name": "Hungry Valley SVRA", "Description": "Hungry Valley SVRA", "HasAlerts": false, "IsFavourite": false, "Allhighlights": "Bicycling<br>Birdwatching<br>Camping<br>Group Camping<br>Hiking<br>Horseback riding<br>Off Road Vehicles<br>Visitor Center<br>", "Url": "http://www.parks.ca.gov/?page_id=1192", "ImageUrl": "https://cali-content.usedirect.com/Images/California/ParkImages/Place/1138.jpg", "BannerUrl": null,