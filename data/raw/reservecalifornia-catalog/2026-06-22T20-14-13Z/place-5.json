Alerts": false, "IsFavourite": false, "Allhighlights": "Birdwatching<br>Boating<br>Camping<br>Fishing<br>Group Camping<br>Hiking<br>Museum<br>Picnic area<br>Scuba diving<br>Store-convenience<br>Swimming<br>Visitor Center<br>", "Url": "http://www.parks.ca.gov/?page_id=505", "ImageUrl": "https://cali-content.usedirect.com/Images/California/ParkImages/Place/637.jpg", "BannerUrl": null, "ParkSize": "Small", "Latitude": 38.97790522, "Longitude": -120.103013, "TimeZone": "America/Los_Angeles", "TimeStamp": "2026-06-22 13:18:16", "MilesFromSelected": 50, "Available": false, "AvailableFiltered": true, "ParkCategoryId": 1, "ParkActivity": 3, "ParkPopularity": 0, "AvailableUnitCount": 0, "PartialAvailable": false, "Restrictions": {"FutureBookingStarts": "2026-06-24T00:00:00-07:00", "FutureBookingEnds": "2026-12-22T00:00:00-08:00", "MinimumStay": 1, "MaximumStay": 15, "IsRestrictionValid": false, "Time": "0001-01-01T00:00:00"}, "Facilities": {}, "IsAvailableForGreatwalk": false, "IsReservationAnyDrawActive": true, "FacilityDefaultZoom": 13, "IsReservationDrawActive": false}, {"PlaceId": 724, "Name": "Sugar Pine Point SP", "Description": "Sugar Pine Point State Park contains one of the finest remaining natural areas on  Lake Tahoe.  With nearly two miles of  lake frontage, the park has dense forests of pine, fir, aspen and cedar.  Deep-line anglers fish the lake's 300-foot deep underwater ledges for trout and salmon.  Another attraction is the museum in the Hellman-Ehrman Mansion (also known as Pine Lodge), a summer home built in 1903 in a grove of pine and cedar. During winter, the park features cross-country skiing areas.", "HasAlerts": false, "IsFavourite": false, "Allhighlights": "Bicycling<br>Birdwatching<br>Boating<br>Body surfing<br>Camping<br>Fishing<br>Group Camping<br>Hiking<br>Museum<br>Picnic area<br>Scuba diving<br>Surfing<br>Swimming<br>Visitor Center<br>", "Url": "http://www.parks.ca.gov/?page_id=510", "ImageUrl": "https://cali-content.usedirect.com/Images/California/ParkImages/Place/724.jpg", "BannerUrl": null, "ParkSize": "Small", "Latitude": 39.04992423, "Longitude": -120.115051, "TimeZone": "America/Los_Angeles", "TimeStamp": "2026-06-22 13:18:16", "MilesFromSelected": 55, "Available": false, "AvailableFiltered": true, "ParkCategoryId": 1, "ParkActivity": 3, "ParkPopularity": 0, "AvailableUnitCount": 0, "PartialAvailable": false, "Restrictions": {"FutureBookingStarts": "2026-06-24T00:00:00-07:00", "FutureBookingEnds": "2026-12-22T00:00:00-08:00", "MinimumStay": 1, "MaximumStay": 7, "IsRestrictionValid": false, "Time": "0001-01-01T00:00:00"}, "Facilities": {}, "IsAvailableForGreatwalk": false, "IsReservationAnyDrawActive": true, "FacilityDefaultZoom": 13, "IsReservationDrawActive": false}, {"PlaceId": 1260, "Name": "Folsom Lake SRA Glamping", "Description": "New area of 40 foot sites available for reservations YEAR ROUND. Located at the base of the Sierra foothills, the 18,000 acre lake and recreation area offers opportunities for hiking, biking, running, camping, picnicking, horseback riding, water skiing and boating. Fishing offers trout, catfish, big and small mouth bass or perch. Visitors can also see the Folsom Powerhouse (once called the greatest operative electrical plant on the American continent;), which from 1885 to 1952 produced 11,000 volts of electricity for Sacramento residents. For cyclists, there is a 32 mile long bicycle path that connects Folsom Lake with many Sacramento County parks before reaching Old Sacramento. The park also includes Lake Natoma, downstream from Folsom Lake, which is popular for crew races, sailing.", "HasAlerts": false, "IsFavourite": false, "Allhighlights": null, "Url": "https://www.parks.ca.gov/?page_id=500", "ImageUrl": "https://cali-content.usedirect.com/Images/California/ParkImages/Place/1260.jpg", "BannerUrl": null, "ParkSize": "Small", "Latitude": 38.70887756347656, "Longitude": -121.17040252685547, "TimeZone": "America/Los_Angeles", "TimeStamp": "2026-06-22 13:18:16", "MilesFromSelected": 56, "Available": false, "AvailableFiltered": true, "ParkCategoryId": 6, "ParkActivity": 1, "ParkPopularity": 0, "AvailableUnitCount": 0, "PartialAvailable": false, "Restrictions": {"FutureBookingStarts": "2026-06-24T00:00:00-07:00", "FutureBookingEnds": "2026-12-22T00:00:00-08:00", "MinimumStay": 2, "MaximumStay": 14, "IsRestrictionValid": false, "Time": "0001-01-01T00:00:00"}, "Facilities": {}, "IsAvailableForGreatwalk": false, "IsReservationAnyDrawActive": true, "FacilityDefaultZoom": 13, "IsReservationDrawActive": false}, {"PlaceId": 643, "Name": "Folsom Lake SRA", "Description": "New area of 40 foot sites available for reservations YEAR ROUND.  Located at the base of\n the Sierra foothills, the 18,000 acre lake and recreation area offers opportunities for hiking, biking, running, camping, picnicking,\nhorseback riding, water skiing and boating.  Fishing offers trout, catfish, big and small mouth bass or perch.  Visitors can also\n see the Folsom Powerhouse (once called the greatest operative electrical plant on the American continent;), which from 1885 to\n  1952 produced 11,000 volts of electricity for Sacramento residents. For cyclists, there is a 32 mile long bicycle path that\n connects Folsom Lake with many Sacramento County parks before reaching Old Sacramento. The park also includes Lake Natoma,\ndownstream from Folsom Lake, which is popular for crew races, sailing.", "HasAlerts": true, "IsFavourite": false, "Allhighlights": "Bicycling<br>Birdwatching<br>Boating<br>Boat launch<br>Body surfing<br>Camping<br>Fishing<br>Group Camping<br>Hiking<br>Horseback riding<br>Picnic area<br>Surfing<br>Swimming<br>", "Url": "http://www.parks.ca.gov/?page_id=500", "ImageUrl": "https://cali-content.usedirect.com/Images/California/ParkImages/Place/643.jpg", "BannerUrl": null, "ParkSize": "Small", "Latitude": 38.70887712, "Longitude": -121.1703991, "TimeZone": "America/Los_Angeles", "TimeStamp": "2026-06-22 13:18:16", "MilesFromSelected": 56, "Available": false, "AvailableFiltered": true, "ParkCategoryId": 6, "ParkActivity": 1, "ParkPopularity": 0, "AvailableUnitCount": 0, "PartialAvailable": false, "Restrictions": {"FutureBookingStarts": "2026-06-24T00:00:00-07:00", "FutureBookingEnds": "2026-12-22T00:00:00-08:00", "MinimumStay": 1, "MaximumStay": 7, "IsRestrictionValid": false, "Time": "0001-01-01T00:00:00"}, "Facilities": {}, "IsAvailableForGreatwalk": false, "IsReservationAnyDrawActive": true, "FacilityDefaultZoom": 13, "IsReservationDrawActive": false}, {"PlaceId": 616, "Name": "Auburn SRA", "Description": "Lake Clementine is a small recreational reservoir located on the North Fork of the American River within Auburn SRA, a California State Park. Auburn State Recreation Area contains almost 42,000 acres, including 50 miles of river (much of it is whitewater) on the North and Middle forks of the American River, in the rugged American River Canyon. Lake Clementine features great opportunities for boating, fishing and boat-in camping. The lake has less than 3 miles of navigable waters, through a narrow winding canyon.  Less than 2 miles is free of 5 MPH no wake zones.  The lake has a small marina where annual and daily boat slip rentals are available, and fuel and ice are sold: call (530) 885-5097.  There is a single boat launch, and parking is limited to 25 trailers, 15 of which reserved for campsites.", "HasAlerts": true, "IsFavourite": false, "Allhighlights": "Bicycling<br>Boating<br>Boat launch<br>Camping<br>Fishing<br>Hiking<br>Horseback riding<br>Off Road Vehicles<br>Picnic area<br>Swimming<br>", "Url": "http://www.parks.ca.gov/?page_id=502", "ImageUrl": "https://cali-content.usedirect.com/Images/California/ParkImages/Place/616.jpg", "BannerUrl": null, "ParkSize": "Medium", "Latitude": 38.91580514, "Longitude": -121.0410131, "TimeZone": "America/Los_Angeles", "TimeStamp": "2026-06-22 13:18:16", "MilesFromSelected": 60, "Available": false, "AvailableFiltered": true, "ParkCategoryId": 6, "ParkActivity": 3, "ParkPopularity": 0, "AvailableUnitCount": 0, "PartialAvailable": false, "Restrictions": {"FutureBookingStarts": "2026-06-24T00:00:00-07:00", "FutureBookingEnds": "2026-12-22T00:00:00-08:00", "MinimumStay": 1, "MaximumStay": 30, "IsRestrictionValid": false, "Time": "0001-01-01T00:00:00"}, "Facilities": {}, "IsAvailableForGreatwalk": false, "IsReservationAnyDrawActive": true, "FacilityDefaultZoom": 13, "IsReservationDrawActive": false}, {"PlaceId": 625, "Name": "Caswell Memorial SP", "Description": "Caswell Memorial SP is a small, wild refuge in the midst of the Great Central Valley. It's home to endangered animals, wildlife, nature trails, an Oak Forest, and protects one of the last oak-riparian woodlands. The Stanislaus River meanders through Caswell, with beaches and swimming near facilities.\r\n", "HasAlerts": true, "IsFavourite": false, "Allhighlights": "Bicycling<br>Birdwatching<br>Boating<br>Camping<br>Fishing<br>Group Camping<br>Hiking<br>Picnic area<br>Swimming<br>", "Url": "http://www.parks.ca.gov/?page_id=557", "ImageUrl": "https://cali-content.usedirect.com/Images/California/ParkImages/Place/625.jpg", "BannerUrl": null, "ParkSize": "small", "Latitude": 37.70003503, "Longitude": -121.182913, "TimeZone": "America/Los_Angeles", "TimeStamp": "2026-06-22 13:18:16", "MilesFromSelected": 63, "Available": false, "AvailableFiltered": true, "ParkCategoryId": 1, "ParkActivity": 3, "ParkPopularity": 0, "AvailableUnitCount": 0, "PartialAvailable": false, "Restrictions": {"FutureBookingStarts": "2026-06-24T00:00:00-07:00", "FutureBookingEnds": "2026-12-22T00:00:00-08:00", "MinimumStay": 1, "MaximumStay": 30, "IsRestrictionValid": false, "Time": "0001-01-01T00:00:00"}, "Facilities": {}, "IsAvailableForGreatwalk": false, "IsReservationAnyDrawActive": true, "FacilityDefaultZoom": 13, "IsReservationDrawActive": false}, {"PlaceId": 728, "Name": "Tahoe SRA", "Description": "Park is located in Tahoe City, near shopping malls and restaurants. Picturesque views of Lake Tahoe from the campground nestled in groves of Ponderosa and Jefferey pine.  Sugar Pine Point SP, (11 miles south on State Highway 89), is suggested if more secluded campsites are desired. Alternate park phone number is 530-525-7982.", "HasAlerts": false, "IsFavourite": false, "Allhighlights": "Bicycling<br>Boating<br>Body surfing<br>Camping<br>Fishing<br>Hiking<br>Museum<br>Picnic area<br>Surfing<br>Visitor Center<br>", "Url": "http://www.parks.ca.gov/?page_id=504", "ImageUrl": "https://cali-content.usedirect.com/Images/California/ParkImages/Place/728.jpg", "BannerUrl": null, "ParkSize": "Medium", "Latitude": 39.17619924, "Longitude": -120.135044, "TimeZone": "America/Los_Angeles", "TimeStamp": "2026-06-22 13:18:16", "MilesFromSelected": 63, "Available": false, "AvailableFiltered": true, "ParkCategoryId": 6, "ParkActivity": 1, "ParkPopularity": 0, "AvailableUnitCount": 0, "PartialAvailable": false, "Restrictions": {"FutureBookingStarts": "2026-06-24T00:00:00-07:00", "FutureBookingEnds": "2026-12-22T00:00:00-08:00", "MinimumStay": 1, "MaximumStay": 15, "IsRestrictionValid": false, "Time": "0001-01-01T00:00:00"}, "Facilities": {}, "IsAvailableForGreatwalk": false, "IsReservationAnyDrawActive": true, "FacilityDefaultZoom": 13, "IsReservationDrawActive": false}, {"PlaceId": 676, "Name": "Mcconnell SRA", "Description": "McConnell State Recreation Area is located on the banks of the Merced River. It offers over 70 acres of outdoor activities for families and fishermen. Spring, summer, and fall offer fishing, camping, picnicking, river wading, sunbathing, hiking and nature study.", "HasAlerts": false, "IsFavourite": false, "Allhighlights": "Boating<br>Camping<br>Fishing<br>Group Camping<br>Hiking<br>Picnic area<br>Rinse Showers<br>Swimming<br>", "Url": "http://www.parks.ca.gov/?page_id=554", "ImageUrl": "https://cali-content.usedirect.com/Images/California/ParkImages/Place/676.jpg", "BannerUrl": null, "ParkSize": "Medium", "Latitude": 37.41663704, "Longitude": -120.7132969, "TimeZone": "America/Los_Angeles", "TimeStamp": "2026-06-22 13:18:16", "MilesFromSelected": 64, "Available": false, "AvailableFiltered": true, "ParkCategoryId": 6, "ParkActivity": 3, "ParkPopularity": 0, "AvailableUnitCount": 0, "PartialAvailable": false, "Restrictions": {"FutureBookingStarts": "2026-06-24T00:00:00-07:00", "FutureBookingEnds": "2026-12-22T00:00:00-08:00", "MinimumStay": 1, "MaximumStay": 10, "IsRestrictionValid": false, "Time": "0001-01-01T00:00:00"}, "Facilities": {}, "IsAvailableForGreatwalk": false, "IsReservationAnyDrawActive": true, "FacilityDefaultZoom": 13, "IsReservationDrawActive": false}, {"PlaceId": 640, "Name": "Donner Memorial SP", "Description": "Donner Memorial State Park is located on Donner Lake in the Sierra-Nevada. Closed when not on reservations.mountain range. The park contains the Emigrant Trail Museum, with exhibits recounting the tragic story of the ill-fated Donner Party trapped in the are during the severe winter of 1846-47. The museum also", "HasAlerts": false, "IsFavourite": false, "Allhighlights": "Bicycling<br>Boating<br>nearby boating launch available<BR>Camping<br>Fishing<br>Hiking<br>Museum<br>Picnic area<br>Swimming<br>Visitor Center<br>", "Url": "http://www.parks.ca.gov/?page_id=503", "ImageUrl": "https://cali-content.usedirect.com/Images/California/ParkImages/Place/640.jpg", "BannerUrl": null, "ParkSize": "Small", "Latitude": 39.32519399, "Longitude": -120.2381621, "TimeZone": "America/Los_Angeles", "TimeStamp": "2026-06-22 13:18:16", "MilesFromSelected": 73, "Available": false, "AvailableFiltered": true, "ParkCategoryId": 1, "ParkActivity": 3, "ParkPopularity": 0, "AvailableUnitCount": 0, "PartialAvailable": false, "Restrictions": {"FutureBookingStarts": "2026-06-24T00:00:00-07:00", "FutureBookingEnds": "2026-12-22T00:00:00-08:00", "MinimumStay": 1, "MaximumStay": 15, "IsRestrictionValid": false, "Time": "0001-01-01T00:00:00"}, "Facilities": {}, "IsAvailableForGreatwalk": false, "IsReservationAnyDrawActive": true, "FacilityDefaultZoom": 13, "IsReservationDrawActive": false}, {"PlaceId": 648, "Name": "George J. Hatfield SRA", "Description": "George J. Hatfield SRA is located in the San Joaquin Valley and home to a variety of trees and wildlife. The Merced River meanders through the park, with swimming and fishing activities near facilities. It offers spacious grassy fields and picnic tables shaded by native oak trees for day use activities.\r\n", "HasAlerts": true, "IsFavourite": false, "Allhighlights": "Boating<br>Camping<br>Fishing<br>Group Camping<br>Hiking<br>Picnic area<br>", "Url": "http://www.parks.ca.gov/?page_id=556", "ImageUrl": "https://cali-content.usedirect.com/Images/California/ParkImages/Place/648.jpg", "BannerUrl": null, "ParkSize": "Medium", "Latitude": 37.35220501, "Longitude": -120.9610129, "TimeZone": "America/Los_Angeles", "TimeStamp": "2026-06-22 13:18:16", "MilesFromSelected": 74, "Available": false, "AvailableFiltered": true, "ParkCategoryId": 6, "ParkActivity": 3, "ParkPopularity": 0, "AvailableUnitCount": 0, "PartialAvailable": false, "Restrictions": {"FutureBookingStarts": "2026-06-24T00:00:00-07:00", "FutureBookingEnds": "2026-12-22T00:00:00-08:00", "MinimumStay": 1, "MaximumStay": 7, "IsRestrictionValid": false, "Time": "0001-01-01T00:00:00"}, "Facilities": {}, "IsAvailableForGreatwalk": false, "IsReservationAnyDrawActive": true, "FacilityDefaultZoom": 13, "IsReservationDrawActive": false}, {"PlaceId": 621, "Name": "Brannan Island SRA", "Description": "Brannan Island State Recreation Area is located in the Sacramento-San Joaquin Delta. This area northeast of San Francisco Bay has countless islands and marshes with many wildlife habitats and many opportunities for recreation-including boating, windsurfing, and swimming. One of the outstanding water-oriented recreation areas in the world, the area offers great fishing, which includes striped bass, sturgeon, catfish, bluegill, perch, and bullhead. Little Frank's Tract, a protected wetland marsh, is home to beaver, muskrat, river otter, mink, and 76 species of birds.", "HasAlerts": true, "IsFavourite": false, "Allhighlights": "Bicycling<br>Birdwatching<br>Boating<br>Boat launch<br>Body surfing<br>Camping<br>Fishing<br>Group Camping<br>Hiking<br>Lodging<br>Picnic area<br>Rinse Showers<br>Surfing<br>Swimming<br>Visitor Center<br>", "Url": "http://www.parks.ca.gov/?page_id=487", "ImageUrl": "https://cali-content.usedirect.com/Images/California/ParkImages/Place/621.jpg", "BannerUrl": null, "ParkSize": "Small", "Latitude": 38.11292489443076, "Longitude": -121.69129623750246, "TimeZone": "America/Los_Angeles", "TimeStamp": "2026-06-22 13:18:16", "MilesFromSelected": 76, "Available": false, "AvailableFiltered": true, "ParkCategoryId": 6, "ParkActivity": 1, "ParkPopularity": 0, "AvailableUnitCount": 0, "PartialAvailable": false, "Restrictions": {"FutureBookingStarts": "2026-06-24T00:00:00-07:00", "FutureBookingEnds": "2026-12-22T00:00:00-08:00", "MinimumStay": 1, "MaximumStay": 30, "IsRestrictionValid": false, "Time": "0001-01-01T00:00:00"}, "Facilities": {}, "IsAvailableForGreatwalk": false, "IsReservationAnyDrawActive": true, "FacilityDefaultZoom": 13, "IsReservationDrawActive": false}, {"PlaceId": 669, "Name": "Malakoff Diggins SHP", "Description": "Malakoff Diggins State Historic Park, a forested 3,000-acre park, is the site of California's largest hydraulic gold mine. Visitors can see huge cliffs carved by mighty streams of water, results of the gold-mining technique of washing away entire mountains to find the precious metal. Legal battles between mine owners and downstream farmers ended this method. The park also contains a 7,847-foot bedrock tunnel that serves as a drain. The visitor center has exhibits on life in the old mining town of North Bloomfield.", "HasAlerts": false, "IsFavourite": false, "Allhighlights": "Bicycling<br>Camping<br>Fishing<br>Group Camping<br>Hiking<br>Horseback riding<br>Museum<br>Picnic area<br>Visitor Center<br>", "Url": "http://www.parks.ca.gov/?page_id=494", "ImageUrl": "https://cali-content.usedirect.com/Images/California/ParkImages/Place/669.jpg", "BannerUrl": null, "ParkSize": "Small", "Latitude": 39.36609519, "Longitude": -120.8988432, "TimeZone": "America/Los_Angeles", "TimeStamp": "2026-06-22 13:18:16", "MilesFromSelected": 82, "Available": false, "AvailableFiltered": true, "ParkCategoryId": 3, "ParkActivity": 3, "ParkPopularity": 0, "AvailableUnitCount": 0, "PartialAvailable": false, "Restrictions": {"FutureBookingStarts": "2026-06-24T00:00:00-07:00", "FutureBookingEnds": "2026-12-22T00:00:00-08:00", "MinimumStay": 1, "MaximumStay": 30, "IsRestrictionValid": false, "Time": "0001-01-01T00:00:00"}, "Facilities": {}, "IsAvailableForGreatwalk": false, "IsReservationAnyDrawActive": true, "FacilityDefaultZoom": 13, "IsReservationDrawActive": false}, {"PlaceId": 683, "Name": "Mount Diablo SP", "Description": "People visit Mount Diablo State Park for many different reasons. Some drive to the summit (located at 3,849’) to enjoy the incredible views on a clear day, while others enjoy watching the sunset on a warm summer night. With more than 160 miles of trails and fire roads, hikers, mountain bicyclists, trail runners, and equestrians can spend days exploring the 20,000+ acre park. The scenic and challenging roadways are a destination for road bicyclists from the surrounding communities.  Due to the elevation change from the base of the park to the summit, layered clothing is recommended year-round. Fire restrictions occur in late spring through the fall; burning charcoal in provided fire pits is usually allowed unless a Red Flag Warning for the East Bay Hills has been issued. The park boundary gates are closed 30 minutes after sunset and reopen by 8 a.m. the following morning.", "HasAlerts": false, "IsFavourite": false, "Allhighlights": "Bicycling<br>Birdwatching<br>Camping<br>Group Camping<br>Hiking<br>Horseback riding<br>Museum<br>Picnic area<br>Visitor Center<br>", "Url": "http://www.parks.ca.gov/?page_id=517", "ImageUrl": "https://cali-content.usedirect.com/Images/California/ParkImages/Place/683.jpg", "BannerUrl": null, "ParkSize": "Medium", "Latitude": 37.85203099, "Longitude": -121.9254892, "TimeZone": "America/Los_Angeles", "TimeStamp": "2026-06-22 13:18:16", "MilesFromSelected": 93, "Available": false, "AvailableFiltered": true, "ParkCategoryId": 1, "ParkActivity": 1, "ParkPopularity": 0, "AvailableUnitCount": 0, "PartialAvailable": false, "Restrictions": {"FutureBookingStarts": "2026-06-24T00:00:00-07:00", "FutureBookingEnds": "2026-12-22T00:00:00-08:00", "MinimumStay": 1, "MaximumStay": 15, "IsRestrictionValid": false, "Time": "0001-01-01T00:00:00"}, "Facilities": {}, "IsAvailableForGreatwalk": false, "IsReservationAnyDrawActive": true, "FacilityDefaultZoom": 13, "IsReservationDrawActive": false}, {"PlaceId": 678, "Name": "Millerton Lake SRA", "Description": "Millerton Lake SRA offers over 40 miles of shoreline for water sports, swimming, fishing, and boating. Hills surround the lake for hiking. The park is home to ground squirrels, cottontails, mule deer, bald & golden eagles, and badgers. It contains the original Historic Fresno County Courthouse.", "HasAlerts": true, "IsFavourite": false, "Allhighlights": "Bicycling<br>Boating<br>Boat launch<br>Body surfing<br>Camping<br>Fishing<br>Group Camping<br>Hiking<br>Horseback riding<br>Picnic area<br>Rinse Showers<br>Scuba diving<br>Surfing<br>Swimming<br>", "Url": "http://www.parks.ca.gov/?page_id=587", "ImageUrl": "https://cali-content.usedirect.com/Images/California/ParkImages/Place/678.jpg", "BannerUrl": null, "ParkSize": "Small", "Latitude": 37.02130207, "Longitude": -119.6680397, "TimeZone": "America/Los_Angeles", "TimeStamp": "2026-06-22 13:18:16", "MilesFromSelected": 94, "Available": false, "AvailableFiltered": true, "ParkCategoryId": 6, "ParkActivity": 3, "ParkPopularity": 0, "AvailableUnitCount": 0, "PartialAvailable": false, "Restrictions": {"FutureBookingStarts": "2026-06-24T00:00:00-07:00", "FutureBookingEnds": "2026-12-22T00:00:00-08:00", "MinimumStay": 1, "MaximumStay": 14, "IsRestrictionValid": false, "Time": "0001-01-01T00:00:00"}, "Facilities": {}, "IsAvailableForGreatwalk": false, "IsReservationAnyDrawActive": true, "FacilityDefaultZoom": 13, "IsReservationDrawActive": false}, {"PlaceId": 711, "Name": "San Luis Reservoir SRA", "Description": "San Luis Reservoir SRA is nestled in the grassy hills of the western San Joaquin Valley near historic Pacheco Pass. It offers three lakes for fishing, boating, board sailing, camping, and picnicking. The San Luis Reservoir stores runoff water from the Delta that would otherwise flow into the ocean.\r\n", "HasAlerts": true, "IsFavourite": false, "Allhighlights": "Bicycling<br>Birdwatching<br>Boating<br>Boat launch<br>Body surfing<br>Camping<br>Fishing<br>Group Camping<br>Hiking<br>Horseback riding<br>Off Road Vehicles<br>Picnic area<br>Rinse Showers<br>Surfing<br>Swimming<br>", "Url": "http://www.parks.ca.gov/?page_id=558", "ImageUrl": "https://cali-content.usedirect.com/Images/California/ParkImages/Place/711.jpg", "BannerUrl": null, "ParkSize": "large", "Latitude": 37.03626598, "Longitude": -121.0917829, "TimeZone": "America/Los_Angeles", "TimeStamp": "2026-06-22 13:18:16", "MilesFromSelected": 96, "Available": false, "AvailableFiltered": true, "ParkCategoryId": 6, "ParkActivity": 3, "ParkPopularity": 0, "AvailableUnitCount": 0, "PartialAvailable": false, "Restrictions": {"FutureBookingStarts": "2026-06-24T00:00:00-07:00", "FutureBookingEnds": "2026-12-22T00:00:00-08:00", "MinimumStay": 1, "MaximumStay": 7, "IsRestrictionValid": false, "Time": "0001-01-01T00:00:00"}, "Facilities": {}, "IsAvailableForGreatwalk": false, "IsReservationAnyDrawActive": true, "FacilityDefaultZoom": 13, "IsReservationDrawActive": false}]}, "part": "place-5"}