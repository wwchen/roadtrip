railhead in the parking area. Gaviota Peak offers a view of the coast and the Channel Islands.", "HasAlerts": true, "IsFavourite": false, "Allhighlights": "Bicycling<br>Boating<br>Body surfing<br>Camping<br>Fishing<br>Hiking<br>Horseback riding<br>Picnic area<br>Rinse Showers<br>Scuba diving<br>Store-convenience<br>Surfing<br>Swimming<br>", "Url": "http://www.parks.ca.gov/?page_id=606", "ImageUrl": "https://cali-content.usedirect.com/Images/California/ParkImages/Place/646.jpg", "BannerUrl": null, "ParkSize": "Medium", "Latitude": 34.47315079, "Longitude": -120.2294715, "TimeZone": "America/Los_Angeles", "TimeStamp": "2026-06-22 13:14:21", "MilesFromSelected": 66, "Available": false, "AvailableFiltered": false, "ParkCategoryId": 1, "ParkActivity": 3, "ParkPopularity": 0, "AvailableUnitCount": 0, "PartialAvailable": false, "Restrictions": {"FutureBookingStarts": "2026-06-22T00:00:00-07:00", "FutureBookingEnds": "2026-12-22T00:00:00-08:00", "MinimumStay": 1, "MaximumStay": 7, "IsRestrictionValid": false, "Time": "0001-01-01T00:00:00"}, "Facilities": {}, "IsAvailableForGreatwalk": false, "IsReservationAnyDrawActive": true, "FacilityDefaultZoom": 13, "IsReservationDrawActive": false}, {"PlaceId": 699, "Name": "Refugio SB", "Description": "Refugio State Beach offers excellent coastal fishing as well as trails and picnic sites. Palm trees planted near Refugio Creek give a distinctive look to the beach and camping area.", "HasAlerts": false, "IsFavourite": false, "Allhighlights": "Bicycling<br>Boating<br>Body surfing<br>Camping<br>Fishing<br>Group Camping<br>Hiking<br>Picnic area<br>Playground<br>Rinse Showers<br>Store-convenience<br>Surfing<br>Swimming<br>Visitor Center<br>", "Url": "http://www.parks.ca.gov/?page_id=603", "ImageUrl": "https://cali-content.usedirect.com/Images/California/ParkImages/Place/699.jpg", "BannerUrl": null, "ParkSize": "Medium", "Latitude": 34.46512979, "Longitude": -120.0690825, "TimeZone": "America/Los_Angeles", "TimeStamp": "2026-06-22 13:14:21"