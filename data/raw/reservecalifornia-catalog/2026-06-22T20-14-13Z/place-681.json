servationDrawActive": false}, {"PlaceId": 686, "Name": "Oceano Dunes SVRA", "Description": "Oceano Dunes State Vehicular Recreation Area has 1,500 acres, featuring beach and sand dune riding.  Thousands of off-highway vehicle enthusiasts enjoy the beach dunes of this SVRA most weekends during the summer. It is a motorcycle, four-wheel drive, all-terrain vehicle, and dune buggy use area. Camping is allowed on the beach.", "HasAlerts": true, "IsFavourite": false, "Allhighlights": "Birdwatching<br>Boating<br>Body surfing<br>Camping<br>Fishing<br>Group Camping<br>Hiking<br>Horseback riding<br>Off Road Vehicles<br>Rinse Showers<br>Scuba diving<br>Store-convenience<br>Surfing<br>Swimming<br>", "Url": "http://www.ohv.parks.ca.gov/?page_id=1207", "ImageUrl": "https://cali-content.usedirect.com/Images/California/ParkImages/Place/686.jpg", "BannerUrl": null, "ParkSize": "Medium", "Latitude": 35.09321039, "Longitude": -120.6178957, "TimeZone": "America/Los_Angeles", "TimeStamp": "2026-06-22 13:14:31", "MilesFromSelected": 26, "Available": true, "AvailableFiltered": true, "ParkCategoryId": 4, "ParkActivity": 1, "ParkPopularity": 0, "AvailableUnitCount": 241, "PartialAvailable": false, "Restrictions": {"FutureBookingStarts": "2026-06-22T00:00:00-07:00", "FutureBookingEnds": "2026-12-22T00:00:00-08:00", "MinimumStay": 1, "MaximumStay": 30, "IsRestrictionValid": true, "Time": "0001-01-01T00:00:00"}, "Facilities": {}, "IsAvailableForGreatwalk": false, "IsReservationAnyDrawActive": true, "FacilityDefaultZoom": 13, "IsReservationDrawActive": false}, {"PlaceId": 666, "Name": "Limekiln SP", "Description": "Limekiln State Park contains 716-acres. The park features breath taking views of the Big Sur Coast. The park features the beauty of the redwoods, the rugged coast, and the cultural history of limekilns.", "HasAlerts": true, "IsFavourite": false, "Allhighlights": "Camping<br>Fishing<br>Hiking<br>", "Url": "http://www.parks.ca.gov/?page_id=577", "ImageUrl": "https://cali-content.usedirect.com/Images/California/ParkImages/Place/666.jpg", "BannerUrl": null, "ParkSize": "Medium", "Latitude": 36.00990485, "Longitude": -121.5180129, "TimeZone": "America/Los_Angeles", "TimeStamp": "2026-06-22 13:14:31", "MilesFromSelected": 56, "Available": false, "AvailableFiltered": false, "ParkCategoryId": 1, "ParkActivity": 3, "ParkPopularity": 0, "AvailableUnitCount": 0, "PartialAvailable": false, "Restrictions": {"FutureBookingStarts": "2026-06-24T00:00:00-07:00", "FutureBookingEnds": "2026-12-22T00:00:00-08:00", "MinimumStay": 1, "MaximumStay": 7, "IsRestrictionValid": false, "Time": "0001-01-01T00:00:00"}, "Facilities": {}, "IsAvailableForGreatwalk": false, "IsReservationAnyDrawActive": true, "FacilityDefaultZoom": 13, "IsReservationDrawActive": false}, {"PlaceId": 661, "Name": "Julia Pfeiffer Burns SP", "Description": "Julia Pfeiffer Burns State Park stretches from the Big Sur coastline into nearby 3,000-foot ridges. The park features redwood, tan oak, madrone, chaparral, and an 80-foot waterfall that drops from granite cliffs into the The park also has a 1,680-acre underwater reserve which protects a spectacular assortment of marine life. Special-use permits allow experienced divers to explore the reserve. Seals, sea lions and sea otters can be seen in the park's cove. Hikers can discover the park's backcountry via several trail systems.  There is no park kiosk at Julia Pfeiffer Burns State Park for fee collection. Campers should register at Pfeiffer Big Sur State Park or Big Sur Station.  For Special Events in the parks such as weddings and small celebrations, please e-mail Special Events at BigSurEvents@parks.ca.gov.", "HasAlerts": false, "IsFavourite": false, "Allhighlights": "Birdwatching<br>Camping<br>Hiking<br>Picnic area<br>", "Url": "http://www.parks.ca.gov/?page_id=578", "ImageUrl": "https://cali-content.usedirect.com/Images/California/ParkImages/Place/661.jpg", "BannerUrl": null, "ParkSize": "Medium", "Latitude": 36.15892586, "Longitude": -121.6704589, "TimeZone": "America/Los_Angeles", "TimeStamp": "2026-06-22 13:14:31", "MilesFromSelected": 69, "Available": false, "AvailableFiltered": false, "ParkCategoryId": 1, "ParkActivity": 3, "ParkPopularity": 0, "AvailableUnitCount": 0, "PartialAvailable": false, "Restrictions": {"FutureBookingStarts": "2026-06-24T00:00:00-07:00", "FutureBookingEnds": "2026-12-22T00:00:00-08:00", "MinimumStay": 1, "MaximumStay": 7, "IsRestrictionValid": false, "Time": "0001-01-01T00:00:00"}, "Facilities": {}, "IsAvailableForGreatwalk": false, "IsReservationAnyDrawActive": true, "FacilityDefaultZoom": 13, "IsReservationDrawActive": false}, {"PlaceId": 646, "Name": "Gaviota SP", "Description": "Gaviota State Park is a popular spot for swimming, picnicking and surf fishing. This section of the coast was first called gaviota (seagull) by soldiers of the Portola Expedition in 1769. A pier on the west end of the beach is used by divers and surfers. A Southern Pacific railroad trestle crosses the creek above the day-use parking lot. Visitors can explore the upland portions of the park from a trailhead in the parking area. Gaviota Peak offers a view of the coast and the Channel Islands.", "HasAlerts": true, "IsFavourite": false, "Allhighlights": "Bicycling<br>Boating<br>Body surfing<br>Camping<br>Fishing<br>Hiking<br>Horseback riding<br>Picnic area<br>Rinse Showers<br>Scuba diving<br>Store-convenience<br>Surfing<br>Swimming<br>", "Url": "http://www.parks.ca.gov/?page_id=606", "ImageUrl": "https://cali-content.usedirect.com/Images/California/ParkImages/Place/646.jpg", "BannerUrl": null, "ParkSize": "Medium", "Latitude": 34.47315079, "Longitude": -120.2294715, "TimeZone": "America/Los_Angeles", "TimeStamp": "2026-06-22 13:14:31", "MilesFromSelected": 74, "Available": false, "AvailableFiltered": false, "ParkCategoryId": 1, "ParkActivity": 3, "ParkPopularity": 0, "AvailableUnitCount": 0, "PartialAvailable": false, "Restrictions": {"FutureBookingStarts": "2026-06-22T00:00:00-07:00", "FutureBookingE