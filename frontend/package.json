{
  "name": "roadtrip-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "//": "LDS comes from the npm registry as @lew-ds/*. It was vendored under vendor/* as npm workspaces until 1.0.0 was published; the published tarballs were verified byte-identical to the vendored revision apart from the @lew/ -> @lew-ds/ scope rename, so the swap was a specifier change only. See docs/react-migration-plan.md.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lew-ds/lds": "^1.0.0",
    "@lew-ds/lds-react": "^1.0.0",
    "@lew-ds/open-icons": "^1.0.0",
    "@tanstack/react-query": "^5.62.0",
    "chart.js": "^4.5.1",
    "chartjs-adapter-date-fns": "^3.0.0",
    "date-fns": "^4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^3.2.0"
  }
}
