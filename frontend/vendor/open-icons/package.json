{
  "name": "@lew/open-icons",
  "version": "1.0.0",
  "description": "Open Icons — 174 symbols on a 24px grid, stroke 2. A standalone SVG sprite with no dependency on any design system.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "src",
    "icons.svg",
    "icons.json",
    "names.json"
  ],
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./icons.svg": "./icons.svg",
    "./icons.json": "./icons.json",
    "./names.json": "./names.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build-sprite.mjs",
    "test": "node scripts/verify.mjs"
  },
  "keywords": ["icons", "svg", "sprite", "open-icons"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matthewlew/open-icons.git"
  }
}
