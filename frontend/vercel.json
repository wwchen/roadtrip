{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd .. && npm ci",
  "buildCommand": "cd .. && npm run build -- roadtrip-frontend && npm run build-storybook --workspace roadtrip-frontend",
  "outputDirectory": "storybook-static",
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . ../apps/web/src ../packages ../package.json ../package-lock.json"
}
