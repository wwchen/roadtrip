// Roadtrip observability pipeline:
//
//   backend stdout -> Docker logs -> Alloy -> Loki
//   backend OTLP   -> Alloy       -> Tempo / Prometheus
//
// The Java agent injects trace_id/span_id into Logback MDC. We parse those
// fields for query-time log/trace correlation, but do not promote them to Loki
// labels because every trace id is unique.

otelcol.receiver.otlp "roadtrip" {
  grpc {}
  http {}

  output {
    metrics = [otelcol.processor.batch.roadtrip.input]
    traces  = [otelcol.processor.batch.roadtrip.input]
  }
}

otelcol.processor.batch "roadtrip" {
  output {
    metrics = [otelcol.exporter.prometheus.roadtrip.input]
    traces  = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}

otelcol.exporter.prometheus "roadtrip" {
  forward_to = [prometheus.remote_write.roadtrip.receiver]
}

prometheus.remote_write "roadtrip" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

// Discover all Docker containers on the host and ship their logs to Loki.
// Standard Alloy Docker-logs pattern: discovery.docker -> discovery.relabel
// (strip the leading "/" from the container name into a `container` label)
// -> loki.source.docker -> loki.write.

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  // Only ship this project's containers. Without this, Alloy tails every
  // container on the host (testcontainers-*, dev-env-*, …), which floods
  // Loki with noise and spams "No such container" errors as ephemeral
  // test containers come and go.
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/roadtrip-.*"
    action        = "keep"
  }

  // Strip the leading "/" from the container name into a `container` label.
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "default" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.relabel.containers.output
  relabel_rules    = discovery.relabel.containers.rules
  forward_to       = [loki.process.backend.receiver]
}

loki.process "backend" {
  stage.match {
    selector = "{container=~\"roadtrip-backend.*\"}"

    stage.json {
      expressions = {
        level    = "level",
        span_id  = "mdc.span_id",
        trace_id = "mdc.trace_id",
      }
    }

    stage.labels {
      values = {
        level = "",
      }
    }
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
