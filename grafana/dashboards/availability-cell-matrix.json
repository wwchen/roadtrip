      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "roadtrip-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH scoped AS (\n  SELECT r.id AS reservable_id,\n         coalesce(r.loop || ' / ', '') || coalesce(r.name, r.vendor_id) AS label\n  FROM reservables r\n  JOIN reservable_pois rp ON rp.reservable_id = r.id\n  WHERE ${poi_id:sqlstring} ~ '^[0-9]+$'\n    AND rp.poi_id::text = ${poi_id:sqlstring}\n    AND r.deleted_at IS NULL\n)\nSELECT\n  format('[%s] %s', sc.reservable_id, sc.label) AS site,\n  to_char(c.target_date, 'MM-DD Dy')             AS day,\n  c.status::text                                 AS status\nFROM availability_cell c\nJOIN scoped sc ON sc.reservable_id = c.reservable_id\nWHERE c.target_date >= ${__from:date:YYYY-MM-DD}::date\n  AND c.target_date <= ${__to:date:YYYY-MM-DD}::date\nORDER BY sc.label, c.target_date;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Cell matrix (reservables × dates)",
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "day",
            "rowField": "site",
            "valueField": "status"
          }
        },
        {
          "id": "extractFields",
          "options": {
            "format": "regex",
            "keepSourceField": false,
            "regex": "^\\[(?<reservable_id>\\d+)\\] (?<site>.+)$",
            "source": "site\\day"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {
              "reservable_id": 0,
              "site": 1
            },
            "renameByName": {
              "site": "site / day"
            }
          }
        }
      ],
      "type": "table"
    }
