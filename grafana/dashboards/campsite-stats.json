          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT kind, count(*) AS campsites, count(*) FILTER (WHERE deleted_at IS NULL) AS active_campsites\nFROM campsites\nGROUP BY kind\nORDER BY campsites DESC;",
          "refId": "A"
        }
      ],
      "title": "Campsite counts by kind",
      "type": "table"
    }
