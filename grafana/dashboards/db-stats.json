          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  namespace,\n  count(*) AS rows,\n  count(*) FILTER (WHERE expires_at <= now()) AS expired_rows,\n  pg_size_pretty(sum(payload_bytes)::bigint) AS payload_size,\n  min(created_at) AS oldest_created_at,\n  max(created_at) AS newest_created_at\nFROM grafana_api_cache_metadata\nGROUP BY namespace\nORDER BY rows DESC;",
          "refId": "A"
