      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "roadtrip-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  'pois' AS table_name,\n  max(updated_at) AS latest_updated_at,\n  max(fetched_at) AS latest_fetched_at,\n  now() - max(updated_at) AS latest_update_age\nFROM pois\nUNION ALL\nSELECT\n  'reservables' AS table_name,\n  max(updated_at) AS latest_updated_at,\n  NULL::timestamptz AS latest_fetched_at,\n  now() - max(updated_at) AS latest_update_age\nFROM reservables\nUNION ALL\nSELECT\n  'availability_snapshot' AS table_name,\n  max(observed_at) AS latest_updated_at,\n  NULL::timestamptz AS latest_fetched_at,\n  now() - max(observed_at) AS latest_update_age\nFROM availability_snapshot\nUNION ALL\nSELECT\n  'ingest_runs' AS table_name,\n  max(completed_at) AS latest_updated_at,\n  NULL::timestamptz AS latest_fetched_at,\n  now() - max(completed_at) AS latest_update_age\nFROM ingest_runs\nUNION ALL\nSELECT\n  'import_runs' AS table_name,\n  max(completed_at) AS latest_updated_at,\n  NULL::timestamptz AS latest_fetched_at,\n  now() - max(completed_at) AS latest_update_age\nFROM import_runs\nORDER BY latest_update_age DESC NULLS LAST;",
          "refId": "A"
        }
      ],
      "title": "Catalog Freshness",
      "type": "table"
