      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "roadtrip-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT *\nFROM (\n  VALUES\n    ('pois', (SELECT count(*)::bigint FROM pois)),\n    ('active_pois', (SELECT count(*)::bigint FROM pois WHERE deleted_at IS NULL)),\n    ('reservables', (SELECT count(*)::bigint FROM reservables)),\n    ('active_reservables', (SELECT count(*)::bigint FROM reservables WHERE deleted_at IS NULL)),\n    ('reservable_pois', (SELECT count(*)::bigint FROM reservable_pois)),\n    ('availability_snapshot', (SELECT count(*)::bigint FROM availability_snapshot)),\n    ('availability_watch', (SELECT count(*)::bigint FROM availability_watch)),\n    ('availability_job', (SELECT count(*)::bigint FROM availability_job)),\n    ('availability_job_run', (SELECT count(*)::bigint FROM availability_job_run)),\n    ('ingest_runs', (SELECT count(*)::bigint FROM ingest_runs)),\n    ('import_runs', (SELECT count(*)::bigint FROM import_runs)),\n    ('api_cache_metadata', (SELECT count(*)::bigint FROM grafana_api_cache_metadata))\n) AS counts(table_name, exact_rows)\nORDER BY exact_rows DESC;",
          "refId": "A"
        }
      ],
      "title": "Exact Core Row Counts",
      "type": "table"
    },
    {
      "datasource": {
