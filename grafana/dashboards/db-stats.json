      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "roadtrip-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  relname AS table_name,\n  n_live_tup,\n  n_dead_tup,\n  seq_scan,\n  idx_scan,\n  last_vacuum,\n  last_autovacuum,\n  last_analyze,\n  last_autoanalyze\nFROM pg_stat_user_tables\nORDER BY n_live_tup DESC;",
          "refId": "A"
        }
      ],
      "title": "Table Estimates And Activity",
      "type": "table"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "roadtrip-postgres"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
