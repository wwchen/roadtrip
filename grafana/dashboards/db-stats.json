      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "roadtrip-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  relname AS table_name,\n  pg_relation_size(relid) AS data_bytes,\n  pg_indexes_size(relid) AS index_bytes,\n  pg_total_relation_size(relid) AS total_bytes,\n  pg_size_pretty(pg_total_relation_size(relid)) AS total_size\nFROM pg_catalog.pg_statio_user_tables\nORDER BY pg_total_relation_size(relid) DESC;",
          "refId": "A"
        }
      ],
      "title": "Table Storage",
      "type": "table"
    },
    {
      "datasource": {
