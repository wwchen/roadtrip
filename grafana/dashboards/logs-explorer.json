    {
      "title": "All Roadtrip dashboards",
      "type": "dashboards",
      "icon": "dashboard",
      "tags": [
        "roadtrip"
      ],
      "targetBlank": false,
      "asDropdown": true
    }
  ],
  "panels": [
    {
      "type": "text",
      "id": 1,
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "## 🔎 Logs / Search\nBackend logs, filterable by **class** (`$logger`, regex on `loggerName`), **level** (`$level`), and a free-text / regex **line filter** (`$search`). Filters are query-time `| json`, so partial values match everything. Tip: click a class in *Top classes* to scope the whole page to it. Other JSON fields (`thread`, `mdc.run_id`, …) show under a row's **Detected fields** — expand a line to see them."
      }
    },
    {
      "type": "logs",
      "id": 2,
      "title": "Backend logs",
      "datasource": {
        "type": "loki",
        "uid": "roadtrip-loki"
      },
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "pluginVersion": "12.4.4",
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "roadtrip-loki"
          },
          "expr": "{container=~\"$container\"} | json | level=~\"$level\", loggerName=~\"$logger\" |~ \"$search\"",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Log volume by level",
      "datasource": {
        "type": "loki",
        "uid": "roadtrip-loki"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "pluginVersion": "12.4.4",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "roadtrip-loki"
          },
          "expr": "sum by (level) (count_over_time({container=~\"$container\"} | json | loggerName=~\"$logger\" |~ \"$search\" [$__auto]))",
          "legendFormat": "{{level}}",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "id": 4,
      "title": "Top classes (by log lines)",
      "datasource": {
        "type": "loki",
        "uid": "roadtrip-loki"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "pluginVersion": "12.4.4",
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "loggerName"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "targetBlank": false,
                    "title": "Filter logs to this class",
                    "url": "/d/logs-explorer/logs-explorer?${__url_time_range}&var-container=${container}&var-level=${level}&var-logger=${__data.fields.loggerName}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "roadtrip-loki"
          },
          "expr": "topk(20, sum by (loggerName) (count_over_time({container=~\"$container\"} | json | level=~\"$level\" |~ \"$search\" [$__range])))",
          "instant": true,
          "format": "table",
          "queryType": "instant",
          "refId": "A"
        }
      ]
    },
    {
