  "panels": [
    {
      "type": "text",
      "id": 1,
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "## 🔎 Logs / Search\nBackend logs as a **Datadog-style stream** — columns: **Date · Level · Logger · Message · Context**. Filter by **class** (`$logger`, regex on `loggerName`), **level** (`$level`), and a free-text / regex **line filter** (`$search`). Click a class in *Top classes* (or a **Logger** cell) to scope the whole page to it. Non-JSON JVM boot warnings are dropped via `| __error__=\"\"`, so the level panels no longer show a pipeline error."
      }
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "roadtrip-loki"
      },
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "id": 2,
      "type": "table",
      "title": "Backend logs",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "align": "left",
            "cellOptions": {
              "type": "auto",
              "wrapText": false
            },
            "inspect": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 180
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "level"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 70
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ERROR": {
                        "color": "#F2495C",
                        "index": 0,
                        "text": "ERROR"
                      },
                      "WARN": {
                        "color": "#FF9830",
                        "index": 1,
                        "text": "WARN"
                      },
                      "INFO": {
                        "color": "#5794F2",
                        "index": 2,
                        "text": "INFO"
                      },
                      "DEBUG": {
                        "color": "#8E8E8E",
                        "index": 3,
                        "text": "DEBUG"
                      },
                      "TRACE": {
                        "color": "#B877D9",
                        "index": 4,
                        "text": "TRACE"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "logger"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 260
              },
              {
                "id": "links",
                "value": [
                  {
                    "targetBlank": false,
                    "title": "Filter logs to this class",
                    "url": "/d/logs-explorer/logs-explorer?${__url_time_range}&var-container=${container}&var-level=${level}&var-logger=${__data.fields.loggerName}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "loggerName"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "message"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto",
                  "wrapText": false
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "context"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 300
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "Date",
            "desc": true
          }
        ]
      },
      "pluginVersion": "12.4.4",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "roadtrip-loki"
          },
          "expr": "{container=~\"$container\"} | json level=\"level\", loggerName=\"loggerName\", message=\"message\", context=\"mdc\" | __error__=\"\" | label_format logger=`{{ regexReplaceAll \"([a-zA-Z])[a-zA-Z0-9_]*\\\\.\" .loggerName \"${1}.\" }}` | level=~\"$level\", loggerName=~\"$logger\" |~ \"$search\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(Time|level|logger|loggerName|message|context)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "renameByName": {
              "Time": "Date",
              "level": "Level",
              "logger": "Logger",
              "message": "Message",
              "context": "Context"
            },
            "indexByName": {
              "Time": 0,
              "level": 1,
              "logger": 2,
              "message": 3,
              "context": 4,
              "loggerName": 5
            }
          }
        }
      ]
    },
