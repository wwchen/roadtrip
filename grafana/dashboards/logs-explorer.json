      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "roadtrip-loki"
          },
          "expr": "sum by (level) (count_over_time({container=~\"$container\"} | json | __error__=\"\" | loggerName=~\"$logger\" |~ \"$search\" [$__auto]))",
          "legendFormat": "{{level}}",
          "queryType": "range",
          "refId": "A"
        }
      ]
