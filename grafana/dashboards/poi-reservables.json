      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "roadtrip-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH target_date_input AS (\n  SELECT CASE\n    WHEN ${target_date:sqlstring} ~ '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'\n      THEN ${target_date:sqlstring}::date\n    ELSE current_date\n  END AS target_date\n),\nscoped AS (\n  SELECT r.id AS reservable_id\n  FROM reservables r\n  JOIN reservable_pois rp ON rp.reservable_id = r.id\n  WHERE ${poi_id:sqlstring} ~ '^[0-9]+$'\n    AND rp.poi_id::text = ${poi_id:sqlstring}\n    AND r.deleted_at IS NULL\n),\nobservations AS (\n  SELECT\n    s.id,\n    s.reservable_id,\n    s.status::text AS status,\n    s.last_observed_at\n  FROM availability s\n  JOIN scoped sc ON sc.reservable_id = s.reservable_id\n  JOIN target_date_input target ON target.target_date = s.target_date\n),\nbounds AS (\n  SELECT\n    min(o.last_observed_at) AS first_observed_at,\n    greatest(\n      min(o.last_observed_at),\n      least((target.target_date + interval '1 day')::timestamptz, now())\n    ) AS last_axis_at\n  FROM target_date_input target\n  LEFT JOIN observations o ON true\n  GROUP BY target.target_date\n),\npoints AS (\n  SELECT DISTINCT last_observed_at AS time\n  FROM observations\n  UNION\n  SELECT first_observed_at AS time\n  FROM bounds\n  WHERE first_observed_at IS NOT NULL\n  UNION\n  SELECT last_axis_at AS time\n  FROM bounds\n  WHERE last_axis_at IS NOT NULL\n),\nstatuses(status, sort_order) AS (\n  VALUES\n    ('available', 1),\n    ('first_come', 2),\n    ('reserved', 3),\n    ('booked', 4),\n    ('closed', 5),\n    ('unknown', 6)\n),\nsite_status_at_point AS (\n  SELECT\n    p.time,\n    coalesce(latest.status, 'unknown') AS status\n  FROM points p\n  CROSS JOIN scoped sc\n  LEFT JOIN LATERAL (\n    SELECT o.status\n    FROM observations o\n    WHERE o.reservable_id = sc.reservable_id\n      AND o.last_observed_at <= p.time\n    ORDER BY o.last_observed_at DESC, o.id DESC\n    LIMIT 1\n  ) latest ON true\n),\nstatus_counts AS (\n  SELECT\n    time,\n    status,\n    count(*)::double precision AS value\n  FROM site_status_at_point\n  GROUP BY time, status\n)\nSELECT\n  p.time,\n  st.status AS metric,\n  coalesce(c.value, 0)::double precision AS value\nFROM points p\nCROSS JOIN statuses st\nLEFT JOIN status_counts c ON c.time = p.time AND c.status = st.status\nORDER BY p.time ASC, st.sort_order ASC;",
          "refId": "A",
          "sql": {
            "columns": [
