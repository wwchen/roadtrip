          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  p.id,\n  p.name,\n  ST_X(ST_Centroid(p.geom)) AS lng,\n  ST_Y(ST_Centroid(p.geom)) AS lat,\n  count(DISTINCT r.id) AS reservable_count,\n  max(s.observed_at) AS latest_availability_observed_at\nFROM pois p\nJOIN reservable_pois rp ON rp.poi_id = p.id\nJOIN reservables r ON r.id = rp.reservable_id\nLEFT JOIN availability_snapshot s ON s.reservable_id = r.id\nWHERE p.deleted_at IS NULL\n  AND r.deleted_at IS NULL\n  AND (${poi_name:sqlstring} = '' OR p.name ILIKE '%' || ${poi_name:sqlstring} || '%')\n  AND CASE\n    WHEN ${poi_id:sqlstring} = '' THEN true\n    WHEN ${poi_id:sqlstring} ~ '^[0-9]+$' THEN p.id::text = ${poi_id:sqlstring}\n    ELSE false\n  END\n  AND (${poi_category:sqlstring} IN ('', '__all') OR p.category IN (${poi_category:sqlstring}))\nGROUP BY p.id\nORDER BY reservable_count DESC, p.name ASC, p.id ASC\nLIMIT 1000;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
