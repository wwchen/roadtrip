    {
      "datasource": {
        "type": "postgres",
        "uid": "roadtrip-postgres"
      },
      "description": "Poller identity plus the aggregated intent of the active watches coalesced onto it.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "footer": {
              "reducers": []
            },
            "inspect": false,
            "wrapText": true
