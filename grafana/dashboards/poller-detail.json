          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH intervals AS (\n  SELECT\n    started_at AS time,\n    poller_id,\n    EXTRACT(EPOCH FROM (\n      started_at - lag(started_at) OVER (PARTITION BY poller_id ORDER BY started_at)\n    ))::double precision AS value\n  FROM availability_run\n  WHERE poller_id = NULLIF(${poller_id:sqlstring}, '')::bigint\n)\nSELECT\n  time,\n  ('poller ' || poller_id) AS metric,\n  value\nFROM intervals\nWHERE $__timeFilter(time)\nORDER BY time;",
          "refId": "A"
        }
      ],
      "title": "Effective poll interval over time",
      "type": "timeseries"
