          "rawSql": "SELECT\n  ar.id AS run_id,\n  ar.status,\n  ar.snapshot_count,\n  ar.duration_ms,\n  ar.started_at,\n  ar.completed_at,\n  ar.error\nFROM availability_run ar\nWHERE ar.poller_id = NULLIF(${poller_id:sqlstring}, '')::bigint\nORDER BY ar.started_at DESC, ar.id DESC;",
