        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Field"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 220
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/[0-9]+/",
              "scope": "series"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "json-view"
                }
              },
              {
                "id": "custom.inspect",
                "value": true
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 3,
      "options": {
        "cellHeight": "md",
        "showHeader": true
      },
      "pluginVersion": "13.1.0",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "roadtrip-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  p.provider                      AS \"poller.provider\",\n  p.parent_ref                    AS \"poller.parent_ref\",\n  count(w.id)                     AS \"poller.attached_active_watches\",\n  min(w.start_date)               AS \"poller.window_start\",\n  max(w.end_date)                 AS \"poller.window_end\",\n  min(w.cadence_sec)              AS \"poller.min_cadence_sec\",\n  jsonb_agg(w.reservable_filters) AS \"watch.reservable_filters\",\n  jsonb_agg(w.trigger_config)     AS \"watch.trigger_config\"\nFROM availability_poller p\nLEFT JOIN availability_watch_poller wp ON wp.poller_id = p.id\nLEFT JOIN availability_watch w ON w.id = wp.watch_id AND w.status = 'active'\nWHERE p.id = NULLIF(${poller_id:sqlstring}, '')::bigint\nGROUP BY p.provider, p.parent_ref;",
          "refId": "A"
        }
      ],
      "title": "Poller identity + attached watch config",
      "transformations": [
        {
          "id": "transpose",
          "options": {}
        }
      ],
      "type": "table"
    },
