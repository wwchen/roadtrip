          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT r.id AS run_id, r.poller_id, p.provider, p.parent_ref, r.status, r.started_at, r.finished_at, r.duration_ms, r.snapshot_count, r.error\nFROM availability_run r\nJOIN availability_poller p ON p.id = r.poller_id\nWHERE ${run_id:sqlstring} ~ '^[0-9]+$'\n  AND r.id::text = ${run_id:sqlstring};",
          "refId": "A"
        }
      ],
      "title": "Run summary",
      "type": "table"
