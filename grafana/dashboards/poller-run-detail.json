            "displayName": "{\n    \"kind\": \"poi\",\n    \"poi_id\": 2006,\n    \"end_date\": \"2026-07-09\",\n    \"start_date\": \"2026-07-07\",\n    \"reservable_filters\": {\n    }\n}"
