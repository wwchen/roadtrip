          "rawSql": "SELECT\n  s.reservable_id,\n  to_char(s.target_date, 'YYYY-MM-DD') AS target_date,\n  s.status::text AS status\nFROM availability s\nWHERE s.run_id = NULLIF(${run_id:sqlstring}, '')::bigint\nORDER BY s.reservable_id, s.target_date;",
