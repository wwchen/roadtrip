          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH selected AS (\n  SELECT * FROM availability_run\n  WHERE id = NULLIF(${run_id:sqlstring}, '')::bigint\n)\nSELECT\n  ar.id AS run_id,\n  ar.status,\n  ar.snapshot_count,\n  ar.duration_ms,\n  ar.started_at,\n  ar.completed_at,\n  ar.error,\n  CASE WHEN ar.id = (SELECT id FROM selected) THEN true ELSE false END AS selected\nFROM availability_run ar\nJOIN selected sr ON sr.poller_id = ar.poller_id\nORDER BY ar.started_at DESC, ar.id DESC;",
