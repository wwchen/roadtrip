          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  p.provider           AS \"poller.provider\",\n  p.parent_ref          AS \"poller.parent_ref\",\n  min(w.start_date)       AS \"poller.window_start\",\n  max(w.end_date)         AS \"poller.window_end\",\n  jsonb_agg(w.reservable_filters) AS \"watch.reservable_filters\",\n  jsonb_agg(w.trigger_config)   AS \"watch.trigger_config\"\nFROM availability_run r\nJOIN availability_poller p ON p.id = r.poller_id\nLEFT JOIN availability_watch_poller wp ON wp.poller_id = p.id\nLEFT JOIN availability_watch w ON w.id = wp.watch_id AND w.status = 'active'\nWHERE r.id = NULLIF(${run_id:sqlstring}, '')::bigint\nGROUP BY p.provider, p.parent_ref;",
          "refId": "A",
