        {
          "datasource": {
            "type": "postgres",
            "uid": "roadtrip-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  s.id AS snapshot_id,\n  s.campsite_id,\n  cs.name AS campsite_name,\n  s.target_date,\n  s.status::text AS status,\n  (s.status = 'available') AS available,\n  s.last_observed_at\nFROM availability s\nLEFT JOIN campsites cs ON cs.id = s.campsite_id\nWHERE ${run_id:sqlstring} ~ '^[0-9]+$'\n  AND s.run_id::text = ${run_id:sqlstring}\nORDER BY s.campsite_id, s.target_date ASC;",
          "refId": "A"
        }
      ],
      "title": "Snapshots for this run",
      "type": "table"
    }
