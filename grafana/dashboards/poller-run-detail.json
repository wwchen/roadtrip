          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT created_at, provider, parent_ref, campsite_count, window_start, window_end, outcome, duration_ms, error\nFROM availability_fetch_call\nWHERE ${run_id:sqlstring} ~ '^[0-9]+$'\n  AND run_id::text = ${run_id:sqlstring}\nORDER BY created_at DESC;",
          "refId": "A"
        }
      ],
      "title": "Fetch calls for this run",
