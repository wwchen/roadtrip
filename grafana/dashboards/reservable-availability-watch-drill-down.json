          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroup(r.started_at, '$__interval') AS time,\n  'avg_duration_ms' AS metric,\n  avg(r.duration_ms)::double precision AS value\nFROM availability_run r\nJOIN availability_poller p ON p.id = r.poller_id\nLEFT JOIN availability_watch_poller wp ON wp.poller_id = p.id\nWHERE $__timeFilter(r.started_at)\n  AND r.duration_ms IS NOT NULL\n  AND (${watch_id:sqlstring} IN ('', '__all') OR wp.watch_id::text IN (${watch_id:sqlstring}))\n  AND (${poller_id:sqlstring} IN ('', '__all') OR r.poller_id::text IN (${poller_id:sqlstring}))\n  AND (${run_id:sqlstring} IN ('', '__all') OR r.id::text IN (${run_id:sqlstring}))\nGROUP BY 1\nORDER BY 1;",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "postgres",
            "uid": "roadtrip-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroup(s.observed_at, '$__interval') AS time,\n  'snapshot_rows' AS metric,\n  count(*)::double precision AS value\nFROM availability_snapshot s\nLEFT JOIN availability_run r ON r.id = s.run_id\nLEFT JOIN availability_poller p ON p.id = r.poller_id\nLEFT JOIN availability_watch_poller wp ON wp.poller_id = p.id\nWHERE $__timeFilter(s.observed_at)\n  AND (${watch_id:sqlstring} IN ('', '__all') OR wp.watch_id::text IN (${watch_id:sqlstring}))\n  AND (${poller_id:sqlstring} IN ('', '__all') OR r.poller_id::text IN (${poller_id:sqlstring}))\n  AND (${run_id:sqlstring} IN ('', '__all') OR s.run_id::text IN (${run_id:sqlstring}))\nGROUP BY 1\nORDER BY 1;",
          "refId": "B"
        }
      ],
      "title": "Duration And Snapshot Throughput",
      "type": "timeseries"
