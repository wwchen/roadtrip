      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "roadtrip-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  w.id AS watch_id,\n  w.status AS watch_status,\n  p.id AS poller_id,\n  CASE WHEN p.active THEN 'active' ELSE 'dormant' END AS poller_status,\n  p.provider,\n  p.parent_ref,\n  tgt.scope,\n  tgt.target_count,\n  tgt.targets,\n  w.reservable_filters,\n  w.start_date,\n  w.end_date,\n  w.cadence_sec AS watch_cadence_sec,\n  w.trigger_kinds,\n  w.trigger_config,\n  w.stop_when_triggered,\n  agg.attached_watches,\n  agg.poller_cadence_sec,\n  agg.window_start,\n  agg.window_end,\n  p.next_run_at,\n  p.claimed_until,\n  p.last_run_at,\n  p.updated_at AS poller_updated_at\nFROM availability_watch w\nLEFT JOIN availability_watch_poller wp ON wp.watch_id = w.id\nLEFT JOIN availability_poller p ON p.id = wp.poller_id\n-- A watch now covers a SET of targets (availability_watch_target); summarise\n-- them into scope + count + names rather than one poi/reservable column.\nLEFT JOIN LATERAL (\n  SELECT\n    count(*) AS target_count,\n    CASE\n      WHEN count(*) = 0 THEN NULL\n      WHEN count(*) FILTER (WHERE wt.poi_id IS NOT NULL) > 0\n       AND count(*) FILTER (WHERE wt.reservable_id IS NOT NULL) > 0 THEN 'mixed'\n      WHEN count(*) FILTER (WHERE wt.poi_id IS NOT NULL) > 0 THEN 'poi'\n      ELSE 'reservable'\n    END AS scope,\n    string_agg(\n      COALESCE(poi.name, rv.type || ':' || rv.vendor || ':' || rv.vendor_id),\n      ', ' ORDER BY poi.name NULLS LAST\n    ) AS targets\n  FROM availability_watch_target wt\n  LEFT JOIN pois poi ON poi.id = wt.poi_id\n  LEFT JOIN reservables rv ON rv.id = wt.reservable_id\n  WHERE wt.watch_id = w.id\n) tgt ON true\nLEFT JOIN LATERAL (\n  SELECT\n    count(*) AS attached_watches,\n    min(w2.cadence_sec) AS poller_cadence_sec,\n    min(w2.start_date) AS window_start,\n    max(w2.end_date) AS window_end\n  FROM availability_watch_poller wp2\n  JOIN availability_watch w2 ON w2.id = wp2.watch_id AND w2.status = 'active'\n  WHERE wp2.poller_id = p.id\n) agg ON true\nWHERE (${watch_id:sqlstring} IN ('', '__all') OR w.id::text IN (${watch_id:sqlstring}))\n  AND (${poller_id:sqlstring} IN ('', '__all') OR p.id::text IN (${poller_id:sqlstring}))\nORDER BY\n  p.next_run_at ASC NULLS LAST,\n  w.created_at DESC,\n  w.id DESC;",
          "refId": "A"
        }
      ],
      "title": "Watches & Pollers",
      "type": "table"
    },
