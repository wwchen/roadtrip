          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  count(*) FILTER (WHERE p.active) AS active_pollers,\n  count(*) FILTER (WHERE NOT p.active) AS dormant_pollers,\n  count(*) FILTER (\n    WHERE p.active\n      AND p.next_run_at <= now()\n      AND (p.claimed_until IS NULL OR p.claimed_until < now())\n  ) AS due_now,\n  count(*) FILTER (\n    WHERE p.claimed_until IS NOT NULL\n      AND p.claimed_until >= now()\n  ) AS currently_claimed,\n  count(*) FILTER (\n    WHERE p.claimed_until IS NOT NULL\n      AND p.claimed_until < now()\n      AND p.last_run_at IS NULL\n  ) AS expired_claim_without_run\nFROM availability_poller p;",
          "refId": "A"
        }
      ],
      "title": "Queue Summary",
      "type": "table"
