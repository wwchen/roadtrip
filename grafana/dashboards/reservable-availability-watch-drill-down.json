      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "roadtrip-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "\n  WITH watch_poi AS (\n    SELECT w.id AS watch_id, w.poi_id\n    FROM availability_watch w\n    WHERE w.poi_id IS NOT NULL\n    UNION\n    SELECT w.id AS watch_id, rp.poi_id\n    FROM availability_watch w\n    JOIN reservable_pois rp ON rp.reservable_id = w.reservable_id\n    WHERE w.reservable_id IS NOT NULL\n  )\n  SELECT\n    p.id AS poi_id,\n    p.name AS poi_name,\n    max(jr.started_at) AS last_refreshed_at,\n    count(DISTINCT s.reservable_id) AS total_reservable,\n    count(DISTINCT jr.id) AS job_runs,\n    count(DISTINCT j.id) AS jobs,\n    count(DISTINCT wp.watch_id) AS watches\n  FROM watch_poi wp\n  JOIN pois p ON p.id = wp.poi_id\n  JOIN availability_job j ON j.watch_id = wp.watch_id\n  LEFT JOIN availability_job_run jr\n    ON jr.job_id = j.id\n   AND $__timeFilter(jr.started_at)\n  LEFT JOIN availability_snapshot s ON s.run_id = jr.id\n  WHERE (${watch_id:sqlstring} IN ('', '__all') OR wp.watch_id::text IN (${watch_id:sqlstring}))\n    AND (${job_id:sqlstring} IN ('', '__all') OR j.id::text IN (${job_id:sqlstring}))\n    AND (${run_id:sqlstring} IN ('', '__all') OR jr.id::text IN (${run_id:sqlstring}))\n  GROUP BY p.id, p.name\n  ORDER BY last_refreshed_at DESC NULLS LAST, p.name;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Recent Campground Refreshes",
      "type": "table"
