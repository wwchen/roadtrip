          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroup(jr.started_at, '$__interval') AS time,\n  jr.status AS metric,\n  count(*)::double precision AS value\nFROM availability_job_run jr\nJOIN availability_job j ON j.id = jr.job_id\nWHERE $__timeFilter(jr.started_at)\n  AND (${watch_id:sqlstring} IN ('', '__all') OR j.watch_id::text IN (${watch_id:sqlstring}))\n  AND (${job_id:sqlstring} IN ('', '__all') OR jr.job_id::text IN (${job_id:sqlstring}))\n  AND (${run_id:sqlstring} IN ('', '__all') OR jr.id::text IN (${run_id:sqlstring}))\nGROUP BY 1, 2\nORDER BY 1, 2;",
          "refId": "A"
        }
