          "rawSql": "SELECT\n  j.watch_id,\n  jr.job_id,\n  jr.id AS run_id,\n  jr.status AS run_status,\n  jr.snapshot_count,\n  jr.duration_ms,\n  jr.error,\n  jr.started_at,\n  jr.completed_at,\n  w.poi_id,\n  p.name AS poi_name,\n  w.reservable_id,\n  r.type || ':' || r.vendor || ':' || r.vendor_id AS reservable_rid\nFROM availability_job_run jr\nJOIN availability_job j ON j.id = jr.job_id\nJOIN availability_watch w ON w.id = j.watch_id\nLEFT JOIN pois p ON p.id = w.poi_id\nLEFT JOIN reservables r ON r.id = w.reservable_id\nWHERE $__timeFilter(jr.started_at)\n  AND (${watch_id:sqlstring} IN ('', '__all') OR j.watch_id::text IN (${watch_id:sqlstring}))\n  AND (${job_id:sqlstring} IN ('', '__all') OR jr.job_id::text IN (${job_id:sqlstring}))\n  AND (${run_id:sqlstring} IN ('', '__all') OR jr.id::text IN (${run_id:sqlstring}))\nORDER BY jr.started_at DESC, jr.id DESC;",
          "refId": "A",
