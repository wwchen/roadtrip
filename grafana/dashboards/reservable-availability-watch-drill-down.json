      "pluginVersion": "13.1.0",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "roadtrip-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "\n  WITH watch_poi AS (\n    SELECT wt.watch_id, wt.poi_id\n    FROM availability_watch_target wt\n    WHERE wt.poi_id IS NOT NULL\n    UNION\n    SELECT wt.watch_id, rp.poi_id\n    FROM availability_watch_target wt\n    JOIN reservable_pois rp ON rp.reservable_id = wt.reservable_id\n    WHERE wt.reservable_id IS NOT NULL\n  )\n  SELECT\n    p.id AS poi_id,\n    p.name AS poi_name,\n    max(r.started_at) AS last_refreshed_at,\n    count(DISTINCT s.reservable_id) AS total_reservable,\n    count(DISTINCT r.id) AS runs,\n    count(DISTINCT pl.id) AS pollers,\n    count(DISTINCT wp.watch_id) AS watches\n  FROM watch_poi wp\n  JOIN pois p ON p.id = wp.poi_id\n  JOIN availability_watch_poller awp ON awp.watch_id = wp.watch_id\n  JOIN availability_poller pl ON pl.id = awp.poller_id\n  LEFT JOIN availability_run r\n    ON r.poller_id = pl.id\n   AND $__timeFilter(r.started_at)\n  LEFT JOIN availability_snapshot s ON s.run_id = r.id\n  WHERE (${watch_id:sqlstring} IN ('', '__all') OR wp.watch_id::text IN (${watch_id:sqlstring}))\n    AND (${poller_id:sqlstring} IN ('', '__all') OR pl.id::text IN (${poller_id:sqlstring}))\n    AND (${run_id:sqlstring} IN ('', '__all') OR r.id::text IN (${run_id:sqlstring}))\n  GROUP BY p.id, p.name\n  ORDER BY last_refreshed_at DESC NULLS LAST, p.name;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
