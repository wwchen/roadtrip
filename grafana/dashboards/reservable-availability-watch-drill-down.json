          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroup(jr.started_at, '$__interval') AS time,\n  'avg_duration_ms' AS metric,\n  avg(jr.duration_ms)::double precision AS value\nFROM availability_job_run jr\nJOIN availability_job j ON j.id = jr.job_id\nWHERE $__timeFilter(jr.started_at)\n  AND jr.duration_ms IS NOT NULL\n  AND (${watch_id:sqlstring} IN ('', '__all') OR j.watch_id::text IN (${watch_id:sqlstring}))\n  AND (${job_id:sqlstring} IN ('', '__all') OR jr.job_id::text IN (${job_id:sqlstring}))\n  AND (${run_id:sqlstring} IN ('', '__all') OR jr.id::text IN (${run_id:sqlstring}))\nGROUP BY 1\nORDER BY 1;",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "postgres",
            "uid": "roadtrip-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  $__timeGroup(s.observed_at, '$__interval') AS time,\n  'snapshot_rows' AS metric,\n  count(*)::double precision AS value\nFROM availability_snapshot s\nLEFT JOIN availability_job_run jr ON jr.id = s.run_id\nLEFT JOIN availability_job j ON j.id = jr.job_id\nWHERE $__timeFilter(s.observed_at)\n  AND (${watch_id:sqlstring} IN ('', '__all') OR j.watch_id::text IN (${watch_id:sqlstring}))\n  AND (${job_id:sqlstring} IN ('', '__all') OR jr.job_id::text IN (${job_id:sqlstring}))\n  AND (${run_id:sqlstring} IN ('', '__all') OR s.run_id::text IN (${run_id:sqlstring}))\nGROUP BY 1\nORDER BY 1;",
          "refId": "B"
        }
      ],
