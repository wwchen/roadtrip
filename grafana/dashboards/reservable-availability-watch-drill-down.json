          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  wp.watch_id,\n  p.id AS poller_id,\n  CASE WHEN p.active THEN 'active' ELSE 'dormant' END AS status,\n  cad.cadence_sec,\n  p.last_run_at,\n  p.next_run_at,\n  EXTRACT(EPOCH FROM (p.next_run_at - p.last_run_at))::int AS interval_sec,\n  (p.last_run_at IS NOT NULL\n     AND EXTRACT(EPOCH FROM (p.next_run_at - p.last_run_at)) > cad.cadence_sec) AS backed_off,\n  (SELECT count(*) FROM availability_run r\n     WHERE r.poller_id = p.id AND r.status = 'failed'\n       AND r.started_at > COALESCE(\n         (SELECT max(r2.started_at) FROM availability_run r2\n            WHERE r2.poller_id = p.id AND r2.status = 'completed'), '-infinity')\n  ) AS consecutive_failures\nFROM availability_poller p\nLEFT JOIN availability_watch_poller wp ON wp.poller_id = p.id\nLEFT JOIN LATERAL (\n  SELECT min(w.cadence_sec) AS cadence_sec\n  FROM availability_watch_poller wp2\n  JOIN availability_watch w ON w.id = wp2.watch_id AND w.status = 'active'\n  WHERE wp2.poller_id = p.id\n) cad ON true\nWHERE (${watch_id:sqlstring} IN ('', '__all') OR wp.watch_id::text IN (${watch_id:sqlstring}))\nORDER BY interval_sec DESC NULLS LAST, p.id DESC;",
          "refId": "A",
