          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "  SELECT\n    coalesce(r.loop, '(no loop)') AS loop,\n    count(*)::int                  AS count\n  FROM reservable_pois rp\n  JOIN reservable_pois sib ON sib.poi_id = rp.poi_id\n  JOIN reservables r       ON r.id = sib.reservable_id\n  WHERE rp.reservable_id = NULLIF(${reservable_id:sqlstring}, '')::bigint\n    AND sib.reservable_id <> rp.reservable_id\n    AND (${include_deleted_siblings} OR r.deleted_at IS NULL)\n  GROUP BY r.loop\n  ORDER BY r.loop NULLS LAST;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
