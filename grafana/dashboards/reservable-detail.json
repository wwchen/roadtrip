          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH selected AS (\n  SELECT\n    r.*,\n    r.type || ':' || r.vendor || ':' || r.vendor_id AS rid\n  FROM reservables r\n  WHERE r.type || ':' || r.vendor || ':' || r.vendor_id = ${rid:sqlstring}\n),\nparent_poi AS (\n  SELECT rp.poi_id\n  FROM selected r\n  JOIN reservable_pois rp ON rp.reservable_id = r.id\n  ORDER BY rp.created_at ASC, rp.poi_id ASC\n  LIMIT 1\n)\nSELECT\n  w.id AS watch_id,\n  CASE\n    WHEN w.reservable_id = r.id THEN 'reservable'\n    WHEN w.poi_id = p.poi_id THEN 'parent_poi'\n    ELSE 'unknown'\n  END AS scope,\n  r.rid,\n  w.poi_id,\n  w.reservable_id,\n  w.status,\n  w.start_date,\n  w.end_date,\n  w.cadence_sec,\n  w.trigger_kinds,\n  w.stop_when_triggered,\n  w.created_at,\n  w.updated_at,\n  w.reservable_filters,\n  w.trigger_config\nFROM selected r\nLEFT JOIN parent_poi p ON true\nJOIN availability_watch w\n  ON w.reservable_id = r.id\n  OR (p.poi_id IS NOT NULL AND w.poi_id = p.poi_id)\nORDER BY scope ASC, w.status ASC, w.updated_at DESC, w.id DESC;",
          "refId": "A"
        }
