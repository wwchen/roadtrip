          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  s.last_observed_at AS \"time\",\n  s.target_date::text AS metric,\n  CASE coalesce(s.status::text, 'unknown')\n    WHEN 'available' THEN 4\n    WHEN 'first_come' THEN 3\n    WHEN 'reserved' THEN 2\n    WHEN 'booked' THEN 2\n    WHEN 'closed' THEN 1\n    ELSE 0\n  END::double precision AS value\nFROM availability s\nWHERE s.reservable_id = NULLIF(${reservable_id:sqlstring}, '')::bigint\nORDER BY s.target_date ASC, s.last_observed_at ASC, s.id ASC;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
