          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  s.target_date,\n  (array_agg(s.status::text ORDER BY s.last_observed_at DESC, s.id DESC))[1] AS latest_status,\n  (array_agg((s.status = 'available') ORDER BY s.last_observed_at DESC, s.id DESC))[1] AS latest_available,\n  max(s.last_observed_at) AS last_observed_at,\n  count(*) AS observation_count,\n  max(s.last_observed_at) FILTER (WHERE s.status = 'available') AS last_available_observed_at,\n  max(s.last_observed_at) FILTER (WHERE s.status = 'available') AS last_available_flag_observed_at\nFROM availability s\nWHERE s.reservable_id = NULLIF(${reservable_id:sqlstring}, '')::bigint\nGROUP BY s.target_date\nORDER BY s.target_date ASC;",
