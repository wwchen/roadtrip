          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH selected AS (\n  SELECT r.*\n  FROM reservables r\n  WHERE r.id = NULLIF(${reservable_id:sqlstring}, '')::bigint\n)\nSELECT * FROM (\n  SELECT 'availability_fetch_check' AS signal, max(s.last_observed_at) AS observed_at, count(s.id)::text AS detail\n  FROM selected r\n  LEFT JOIN availability s ON s.reservable_id = r.id\n  UNION ALL\n  SELECT 'etl_import_run', coalesce(ir.completed_at, ir.started_at, r.updated_at), 'import_run_id=' || coalesce(r.last_seen_run_id::text, '') || ' status=' || coalesce(ir.status, '')\n  FROM selected r\n  LEFT JOIN import_runs ir ON ir.id = r.last_seen_run_id\n  UNION ALL\n  SELECT 'reservable_updated_at', r.updated_at, 'row timestamp'\n  FROM selected r\n) recency\nORDER BY signal ASC;",
          "refId": "A"
        }
      ],
