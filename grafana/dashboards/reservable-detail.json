          "rawQuery": true,
          "rawSql": "SELECT\n  count(DISTINCT sib.reservable_id) :: int AS sibling_count\nFROM\n  reservable_pois rp\n  JOIN reservable_pois sib ON sib.poi_id = rp.poi_id\n  JOIN reservables r ON r.id = sib.reservable_id\nWHERE\n  rp.reservable_id = NULLIF(${reservable_id:sqlstring}, '') :: bigint\n  AND sib.reservable_id <> rp.reservable_id\n  AND (\n    ${include_deleted_siblings}\n    OR r.deleted_at IS NULL\n  );",
          "refId": "A",
