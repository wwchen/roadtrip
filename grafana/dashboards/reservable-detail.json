          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH selected AS (\n  SELECT\n    r.*,\n    r.type || ':' || r.vendor || ':' || r.vendor_id AS rid\n  FROM reservables r\n  WHERE r.type || ':' || r.vendor || ':' || r.vendor_id = ${rid:sqlstring}\n)\nSELECT\n  s.target_date,\n  (array_agg(s.status::text ORDER BY s.observed_at DESC, s.id DESC))[1] AS latest_status,\n  (array_agg(s.available ORDER BY s.observed_at DESC, s.id DESC))[1] AS latest_available,\n  max(s.observed_at) AS last_observed_at,\n  count(*) AS observation_count,\n  max(s.observed_at) FILTER (WHERE s.status = 'available') AS last_available_observed_at,\n  max(s.observed_at) FILTER (WHERE s.available) AS last_available_flag_observed_at\nFROM availability_snapshot s\nJOIN selected r ON r.id = s.reservable_id\nGROUP BY s.target_date\nORDER BY s.target_date ASC;",
          "refId": "A"
