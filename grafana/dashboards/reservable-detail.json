      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "roadtrip-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH selected AS (\n  SELECT\n    r.*,\n    r.type || ':' || r.vendor || ':' || r.vendor_id AS rid\n  FROM reservables r\n  WHERE r.type || ':' || r.vendor || ':' || r.vendor_id = ${rid:sqlstring}\n),\ngrouped AS (\n  SELECT\n    s.target_date,\n    (array_agg(s.status::text ORDER BY s.observed_at DESC, s.id DESC))[1] AS latest_status,\n    (array_agg(s.available ORDER BY s.observed_at DESC, s.id DESC))[1] AS latest_available,\n    max(s.observed_at) AS last_observed_at,\n    count(*) AS observation_count,\n    max(s.observed_at) FILTER (WHERE s.status = 'available') AS last_available_observed_at,\n    max(s.observed_at) FILTER (WHERE s.available) AS last_available_flag_observed_at\n  FROM availability_snapshot s\n  JOIN selected r ON r.id = s.reservable_id\n  WHERE $__timeFilter(s.observed_at)\n  GROUP BY s.target_date\n)\nSELECT\n  target_date,\n  CASE latest_status\n    WHEN 'available' THEN 4\n    WHEN 'first_come' THEN 3\n    WHEN 'reserved' THEN 2\n    WHEN 'booked' THEN 2\n    WHEN 'closed' THEN 1\n    ELSE 0\n  END AS status,\n  latest_available,\n  last_observed_at,\n  observation_count,\n  last_available_observed_at,\n  last_available_flag_observed_at\nFROM grouped\nORDER BY target_date ASC;",
          "refId": "A"
        }
      ],
