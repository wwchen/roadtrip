        {
          "datasource": {
            "type": "postgres",
            "uid": "roadtrip-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH selected AS (\n  SELECT\n    r.*,\n    r.type || ':' || r.vendor || ':' || r.vendor_id AS rid\n  FROM reservables r\n  WHERE r.type || ':' || r.vendor || ':' || r.vendor_id = ${rid:sqlstring}\n)\nSELECT kv.field, kv.value\nFROM selected\nCROSS JOIN LATERAL (\n  VALUES\n    ('rid', rid),\n    ('name', coalesce(name, '')),\n    ('type', type),\n    ('vendor', vendor),\n    ('vendor_id', vendor_id),\n    ('source', coalesce(source, '')),\n    ('loop', coalesce(loop, '')),\n    ('site_type', coalesce(site_type, '')),\n    ('created_at', created_at::text),\n    ('updated_at', updated_at::text),\n    ('deleted_at', coalesce(deleted_at::text, '')),\n    ('last_seen_run_id', coalesce(last_seen_run_id::text, ''))\n) AS kv(field, value)\nORDER BY CASE field\n  WHEN 'rid' THEN 1\n  WHEN 'name' THEN 2\n  WHEN 'type' THEN 3\n  WHEN 'vendor' THEN 4\n  WHEN 'vendor_id' THEN 5\n  ELSE 100\nEND;",
          "refId": "A"
        }
      ],
      "title": "Reservable properties",
      "type": "table"
