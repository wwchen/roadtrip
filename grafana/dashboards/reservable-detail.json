          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH selected AS (\n  SELECT\n    r.*,\n    r.type || ':' || r.vendor || ':' || r.vendor_id AS rid\n  FROM reservables r\n  WHERE r.type || ':' || r.vendor || ':' || r.vendor_id = ${rid:sqlstring}\n),\nparent_poi AS (\n  SELECT p.*\n  FROM selected r\n  JOIN reservable_pois rp ON rp.reservable_id = r.id\n  JOIN pois p ON p.id = rp.poi_id\n  ORDER BY rp.created_at ASC, p.id ASC\n  LIMIT 1\n)\nSELECT\n  p.id AS poi_id,\n  p.name,\n  p.category,\n  p.subcategory,\n  p.agency,\n  p.source,\n  p.source_id,\n  p.region,\n  p.country,\n  ST_Y(ST_PointOnSurface(p.geom)) AS latitude,\n  ST_X(ST_PointOnSurface(p.geom)) AS longitude,\n  p.unit_name,\n  p.phone,\n  coalesce(jsonb_pretty(p.address), '') AS address,\n  p.info_url,\n  p.fetched_at,\n  p.updated_at\nFROM parent_poi p;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Parent POI",
      "type": "stat"
    },
