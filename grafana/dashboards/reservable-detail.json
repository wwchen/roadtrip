          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH selected AS (\n  SELECT\n    r.*,\n    r.type || ':' || r.vendor || ':' || r.vendor_id AS rid\n  FROM reservables r\n  WHERE r.type || ':' || r.vendor || ':' || r.vendor_id = ${rid:sqlstring}\n),\nparent_poi AS (\n  SELECT p.*\n  FROM selected r\n  JOIN reservable_pois rp ON rp.reservable_id = r.id\n  JOIN pois p ON p.id = rp.poi_id\n  ORDER BY rp.created_at ASC, p.id ASC\n  LIMIT 1\n)\nSELECT\n  sr.type || ':' || sr.vendor || ':' || sr.vendor_id AS rid,\n  sr.name,\n  sr.loop,\n  sr.site_type,\n  sr.vendor,\n  sr.vendor_id,\n  sr.source,\n  sr.updated_at,\n  sr.deleted_at,\n  CASE WHEN sr.id = (SELECT id FROM selected) THEN true ELSE false END AS selected\nFROM parent_poi p\nJOIN reservable_pois rp ON rp.poi_id = p.id\nJOIN reservables sr ON sr.id = rp.reservable_id\nWHERE (${include_deleted_siblings:sqlstring} = 'true' OR sr.deleted_at IS NULL)\nORDER BY selected DESC, sr.loop NULLS LAST, sr.name NULLS LAST, sr.vendor_id ASC;",
          "refId": "A"
        }
      ],
      "title": "Sibling reservables under parent POI",
      "type": "table"
    },
