          {
            "matcher": {
              "id": "byName",
              "options": "watch_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "targetBlank": false,
                    "title": "Open Watch drill-down",
                    "url": "/d/reservable-watch-drill/reservable-watch-drill?${__url_time_range}&var-watch_id=${__data.fields.watch_id}&var-poller_id=$__all&var-run_id=$__all"
