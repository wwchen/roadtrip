      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "roadtrip-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  count(*) FILTER (WHERE p.active) AS active_pollers,\n  count(*) FILTER (WHERE NOT p.active) AS dormant_pollers,\n  count(*) FILTER (WHERE p.active AND p.next_run_at <= now()\n    AND (p.claimed_until IS NULL OR p.claimed_until < now())) AS due_now,\n  count(*) FILTER (WHERE p.claimed_until IS NOT NULL\n    AND p.claimed_until >= now()) AS in_flight\nFROM availability_poller p;",
          "refId": "A"
        }
      ]
    },
