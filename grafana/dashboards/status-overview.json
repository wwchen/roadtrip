      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "roadtrip-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "\n  SELECT\n    wp.watch_id,\n    r.poller_id,\n    r.id AS run_id,\n    r.status AS run_status,\n    r.snapshot_count,\n    r.duration_ms AS duration,\n    r.error,\n    r.started_at,\n    r.completed_at,\n    CASE\n      WHEN count(wt.*) = 0 THEN NULL\n      WHEN count(*) FILTER (WHERE wt.poi_id IS NOT NULL) > 0\n       AND count(*) FILTER (WHERE wt.reservable_id IS NOT NULL) > 0 THEN 'mixed'\n      WHEN count(*) FILTER (WHERE wt.poi_id IS NOT NULL) > 0 THEN 'poi'\n      ELSE 'reservable'\n    END AS scope,\n    array_remove(array_agg(DISTINCT wt.poi_id), NULL) AS poi_ids,\n    array_remove(array_agg(DISTINCT wt.reservable_id), NULL) AS reservable_ids\n  FROM availability_run r\n  JOIN availability_poller pl ON pl.id = r.poller_id\n  LEFT JOIN availability_watch_poller wp ON wp.poller_id = pl.id\n  LEFT JOIN availability_watch w ON w.id = wp.watch_id\n  LEFT JOIN availability_watch_target wt ON wt.watch_id = w.id\n  WHERE $__timeFilter(r.started_at)\n  GROUP BY\n    wp.watch_id,\n    r.poller_id,\n    r.id,\n    r.status,\n    r.snapshot_count,\n    r.duration_ms,\n    r.error,\n    r.started_at,\n    r.completed_at\n  ORDER BY r.started_at DESC, r.id DESC\n  LIMIT 300;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Recent availability runs",
      "type": "table"
