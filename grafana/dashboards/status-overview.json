          "rawSql": "SELECT\n  w.id AS watch_id,\n  w.status AS watch_status,\n  tgt.scope,\n  tgt.target_count,\n  tgt.targets,\n  w.start_date,\n  w.end_date,\n  w.cadence_sec,\n  w.trigger_kinds,\n  w.stop_when_triggered,\n  count(DISTINCT p.id) AS pollers,\n  min(p.next_run_at) FILTER (WHERE p.active) AS next_run_at,\n  max(p.last_run_at) AS last_run_at,\n  w.created_at\nFROM availability_watch w\nLEFT JOIN availability_watch_poller wp ON wp.watch_id = w.id\nLEFT JOIN availability_poller p ON p.id = wp.poller_id\nLEFT JOIN LATERAL (\n  SELECT\n    CASE\n      WHEN count(*) = 0 THEN NULL\n      WHEN count(*) FILTER (WHERE wt.poi_id IS NOT NULL) > 0\n       AND count(*) FILTER (WHERE wt.reservable_id IS NOT NULL) > 0 THEN 'mixed'\n      WHEN count(*) FILTER (WHERE wt.poi_id IS NOT NULL) > 0 THEN 'poi'\n      ELSE 'reservable'\n    END AS scope,\n    count(*) AS target_count,\n    string_agg(COALESCE(poi.name, rv.type||':'||rv.vendor||':'||rv.vendor_id),\n               ', ' ORDER BY poi.name NULLS LAST) AS targets\n  FROM availability_watch_target wt\n  LEFT JOIN pois poi ON poi.id = wt.poi_id\n  LEFT JOIN reservables rv ON rv.id = wt.reservable_id\n  WHERE wt.watch_id = w.id\n) tgt ON true\nGROUP BY w.id, w.status, tgt.scope, tgt.target_count, tgt.targets,\n         w.start_date, w.end_date, w.cadence_sec, w.trigger_kinds,\n         w.stop_when_triggered, w.created_at\nORDER BY (w.status = 'active') DESC, next_run_at ASC NULLS LAST;",
          "refId": "A"
        }
      ]
    },
