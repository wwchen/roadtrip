      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "roadtrip-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  wp.watch_id,\n  r.poller_id,\n  r.id AS run_id,\n  r.status AS run_status,\n  r.snapshot_count,\n  r.duration_ms,\n  r.error,\n  r.started_at,\n  r.completed_at,\n  tgt.scope,\n  tgt.targets\nFROM availability_run r\nJOIN availability_poller pl ON pl.id = r.poller_id\nLEFT JOIN availability_watch_poller wp ON wp.poller_id = pl.id\nLEFT JOIN availability_watch w ON w.id = wp.watch_id\nLEFT JOIN LATERAL (\n  SELECT\n    CASE\n      WHEN count(*) = 0 THEN NULL\n      WHEN count(*) FILTER (WHERE wt.poi_id IS NOT NULL) > 0\n       AND count(*) FILTER (WHERE wt.reservable_id IS NOT NULL) > 0 THEN 'mixed'\n      WHEN count(*) FILTER (WHERE wt.poi_id IS NOT NULL) > 0 THEN 'poi'\n      ELSE 'reservable'\n    END AS scope,\n    string_agg(COALESCE(poi.name, rv.type||':'||rv.vendor||':'||rv.vendor_id),\n               ', ' ORDER BY poi.name NULLS LAST) AS targets\n  FROM availability_watch_target wt\n  LEFT JOIN pois poi ON poi.id = wt.poi_id\n  LEFT JOIN reservables rv ON rv.id = wt.reservable_id\n  WHERE wt.watch_id = w.id\n) tgt ON true\nWHERE $__timeFilter(r.started_at)\nORDER BY r.started_at DESC, r.id DESC\nLIMIT 300;",
          "refId": "A"
        }
      ]
    },
