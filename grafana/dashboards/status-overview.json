      "pluginVersion": "13.1.0",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "roadtrip-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  (SELECT count(*) FROM availability_run WHERE $__timeFilter(started_at)) AS runs,\n  (SELECT count(*) FROM availability_run WHERE $__timeFilter(started_at) AND status = 'failed') AS failed_runs,\n  (SELECT COALESCE(sum(snapshot_count),0) FROM availability_run WHERE $__timeFilter(started_at)) AS snapshots,\n  (SELECT count(DISTINCT a.campsite_id) FROM availability a WHERE $__timeFilter(a.last_observed_at)) AS campsites_updated,\n  (SELECT count(*) FROM availability WHERE $__timeFilter(last_observed_at)) AS total_db_updates;",
          "refId": "A"
        }
      ],
      "title": "Availability run summary",
      "type": "table"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "roadtrip-postgres"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 2,
      "options": {
        "showHeader": true
      },
      "pluginVersion": "13.1.0",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "roadtrip-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  a.last_observed_at AS transitioned_at,\n  a.campsite_id,\n  cs.loop_name || ' / ' || cs.name AS campsite_name,\n  a.target_date::text AS date,\n  prev.status AS from_status,\n  a.status AS to_status,\n  a.run_id\nFROM availability a\nLEFT JOIN availability prev ON prev.id = a.previous_id\nJOIN campsites cs ON cs.id = a.campsite_id\nWHERE $__timeFilter(a.last_observed_at)\n  AND a.previous_id IS NOT NULL\nORDER BY a.last_observed_at DESC, a.id DESC\nLIMIT 100;",
          "refId": "A"
        }
      ],
      "title": "Recent campsite transitions",
      "type": "table"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "roadtrip-postgres"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 3,
      "options": {
        "showHeader": true
      },
      "pluginVersion": "13.1.0",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "roadtrip-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  w.id AS watch_id,\n  w.status AS watch_status,\n  CASE\n    WHEN count(DISTINCT wt.id) = 0 THEN NULL\n    WHEN count(DISTINCT wt.id) FILTER (WHERE wt.poi_id IS NOT NULL) > 0\n     AND count(DISTINCT wt.id) FILTER (WHERE wt.campsite_id IS NOT NULL) > 0 THEN 'mixed'\n    WHEN count(DISTINCT wt.id) FILTER (WHERE wt.poi_id IS NOT NULL) > 0 THEN 'poi'\n    ELSE 'campsite'\n  END AS scope,\n  count(DISTINCT wt.id) AS target_count,\n  array_agg(\n    DISTINCT CASE\n      WHEN wt.poi_id IS NOT NULL THEN 'poi:' || wt.poi_id::text\n      WHEN wt.campsite_id IS NOT NULL THEN 'campsite:' || wt.campsite_id::text\n    END\n  ) FILTER (WHERE wt.id IS NOT NULL) AS scope_ids,\n  w.campsite_filters,\n  w.start_date,\n  w.end_date,\n  w.cadence_sec,\n  w.trigger_kinds,\n  w.stop_when_triggered,\n  count(DISTINCT p.id) AS pollers,\n  min(p.next_run_at) FILTER (WHERE p.active) AS next_run_at,\n  max(p.last_run_at) AS last_run_at,\n  w.created_at\nFROM availability_watch w\nLEFT JOIN availability_watch_poller wp ON wp.watch_id = w.id\nLEFT JOIN availability_poller p ON p.id = wp.poller_id\nLEFT JOIN availability_watch_target wt ON wt.watch_id = w.id\nGROUP BY w.id, w.status, w.campsite_filters, w.start_date, w.end_date, w.cadence_sec, w.trigger_kinds, w.stop_when_triggered, w.created_at\nORDER BY (w.status = 'active') DESC, next_run_at ASC NULLS LAST;",
          "refId": "A"
        }
      ],
      "title": "Active watches",
      "type": "table"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "roadtrip-postgres"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "id": 4,
      "options": {
        "showHeader": true
      },
      "pluginVersion": "13.1.0",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "roadtrip-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  coalesce(parent.id, phase.id) AS run_id,\n  phase.target,\n  phase.phase,\n  phase.phase_kind,\n  phase.status,\n  phase.started_at,\n  phase.completed_at,\n  phase.exit_code,\n  phase.notes\nFROM ingest_runs phase\nLEFT JOIN ingest_runs parent ON parent.id = phase.parent_run_id\nWHERE phase.status IN ('failed', 'started')\n  AND phase.phase_kind <> 'target'\nORDER BY phase.started_at DESC\nLIMIT 100;",
          "refId": "A"
        }
      ],
      "title": "Failed or stuck ingest phases",
      "type": "table"
    },
