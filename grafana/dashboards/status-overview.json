                        "color": "red",
                        "index": 5
                      },
                      "started": {
                        "color": "yellow",
                        "index": 6
                      },
                      "paused": {
                        "color": "yellow",
                        "index": 7
                      },
                      "rate_limited": {
                        "color": "yellow",
                        "index": 8
                      },
                      "done": {
                        "color": "blue",
                        "index": 9
                      },
                      "noop": {
                        "color": "text",
                        "index": 10
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "target"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "targetBlank": false,
                    "title": "Open Ingest & Catalog Freshness (this target)",
                    "url": "/d/ingest-catalog-freshness/ingest-catalog-freshness?${__url_time_range}&var-target=${__data.fields.target}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "roadtrip-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH ranked AS (\n  SELECT ir.*, row_number() OVER (\n    PARTITION BY ir.target, ir.phase\n    ORDER BY ir.started_at DESC, ir.id DESC) AS rn\n  FROM ingest_runs ir\n  WHERE ir.phase_kind = 'target'\n)\nSELECT target, phase AS run_kind, status,\n       started_at, completed_at,\n       completed_at - started_at AS duration,\n       now() - started_at AS age,\n       counts, triggered_by, notes\nFROM ranked WHERE rn = 1\nORDER BY started_at DESC;",
          "refId": "A"
        }
      ]
    },
