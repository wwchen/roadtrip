          "rawSql": "SELECT $__timeGroup(created_at, '$__interval') AS time,\n       provider || ':' || parent_ref AS metric,\n       count(*)::double precision AS value\nFROM availability_fetch_call\nWHERE $__timeFilter(created_at) AND outcome = 'rate_limited'\nGROUP BY 1, 2 ORDER BY 1;",
          "refId": "A"
        }
      ],
      "title": "Rate-limited upstream fetches (per provider:target)",
      "type": "timeseries"
