          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH ranked AS (\n  SELECT ir.*, row_number() OVER (\n    PARTITION BY ir.target, ir.phase\n    ORDER BY ir.started_at DESC, ir.id DESC) AS rn\n  FROM ingest_runs ir\n  WHERE ir.phase_kind = 'import'\n)\nSELECT target, --phase AS run_kind,\n       started_at as age, -- completed_at,\n       extract(epoch FROM completed_at - started_at) * 1000 AS duration,\n       (counts::jsonb ->> 'seen')::int AS count,\n       notes,\n       status\nFROM ranked WHERE rn = 1\nORDER BY started_at DESC;",
          "refId": "A",
          "sql": {
            "columns": [
