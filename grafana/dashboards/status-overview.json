          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n(\n  SELECT count(DISTINCT target)\n  FROM ingest_runs\n  WHERE phase_kind = 'target'\n    AND $__timeFilter(started_at)\n) AS targets,\n\n(\n  SELECT count(*)\n  FROM ingest_runs\n  WHERE phase_kind = 'target'\n    AND status = 'completed'\n    AND $__timeFilter(started_at)\n) AS \"completed runs\",\n\n(\n  SELECT count(*)\n  FROM ingest_runs\n  WHERE phase_kind = 'target'\n    AND status IN ('failed', 'aborted')\n    AND $__timeFilter(started_at)\n) AS \"failed runs\",\n\n(\n  SELECT count(*)\n  FROM ingest_runs\n  WHERE phase_kind = 'target'\n    AND status = 'started'\n    AND $__timeFilter(started_at)\n) AS \"stuck runs\",\n\n(\n  SELECT max(completed_at)\n  FROM ingest_runs\n  WHERE phase_kind = 'target'\n    AND status = 'completed'\n) AS \"Last Completed\";",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
