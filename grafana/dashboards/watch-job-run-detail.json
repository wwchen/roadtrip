          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH selected AS (\n  SELECT * FROM availability_job_run\n  WHERE id = NULLIF(${run_id:sqlstring}, '')::bigint\n)\nSELECT kv.field, kv.value\nFROM selected r\nCROSS JOIN LATERAL (\n  VALUES\n    ('id', r.id::text),\n    ('job_id', r.job_id::text),\n    ('status', r.status),\n    ('snapshot_count', r.snapshot_count::text),\n    ('duration_ms', coalesce(r.duration_ms::text, '')),\n    ('error', coalesce(r.error, '')),\n    ('started_at', r.started_at::text),\n    ('completed_at', coalesce(r.completed_at::text, ''))\n) AS kv(field, value)\nORDER BY CASE field\n  WHEN 'id' THEN 1\n  WHEN 'job_id' THEN 2\n  WHEN 'status' THEN 3\n  WHEN 'snapshot_count' THEN 4\n  WHEN 'duration_ms' THEN 5\n  WHEN 'error' THEN 6\n  WHEN 'started_at' THEN 7\n  WHEN 'completed_at' THEN 8\n  ELSE 100\nEND;",
          "refId": "A"
        }
      ],
      "title": "Run properties",
      "type": "table"
    },
