            "uid": "roadtrip-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH selected AS (\n  SELECT * FROM availability_job_run\n  WHERE id = NULLIF(${run_id:sqlstring}, '')::bigint\n),\nj AS (\n  SELECT j.* FROM availability_job j JOIN selected r ON r.job_id = j.id\n),\nw AS (\n  SELECT w.* FROM availability_watch w JOIN j ON j.watch_id = w.id\n)\nSELECT 'job.intent_payload' AS field, coalesce(jsonb_pretty(j.intent_payload), '') AS value FROM j\nUNION ALL\nSELECT 'watch.reservable_filters', coalesce(jsonb_pretty(w.reservable_filters), '') FROM w\nUNION ALL\nSELECT 'watch.trigger_config', coalesce(jsonb_pretty(w.trigger_config), '') FROM w;",
          "refId": "A"
        }
      ],
      "title": "Run inputs (job intent + watch config)",
      "type": "table"
