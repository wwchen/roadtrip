          "format": "time_series",
          "rawQuery": true,
          "rawSql": "WITH selected AS (\n  SELECT * FROM availability_job_run\n  WHERE id = NULLIF(${run_id:sqlstring}, '')::bigint\n)\nSELECT\n  s.target_date::timestamptz AS \"time\",\n  CASE WHEN r.id IS NOT NULL\n    THEN r.type || ':' || r.vendor || ':' || r.vendor_id\n    ELSE 'reservable:' || s.reservable_id::text\n  END AS metric,\n  s.status::text AS value\nFROM availability_snapshot s\nJOIN selected sr ON sr.id = s.run_id\nLEFT JOIN reservables r ON r.id = s.reservable_id\nORDER BY metric ASC, s.target_date ASC;",
          "refId": "A"
        }
      ],
