          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH selected AS (\n  SELECT * FROM availability_job_run\n  WHERE id = NULLIF(${run_id:sqlstring}, '')::bigint\n)\nSELECT\n  j.id AS job_id,\n  w.id AS watch_id,\n  w.status AS watch_status,\n  j.status AS job_status,\n  w.cadence_sec,\n  w.start_date,\n  w.end_date,\n  w.trigger_kinds,\n  w.stop_when_triggered,\n  w.poi_id,\n  CASE WHEN r.id IS NOT NULL THEN r.type || ':' || r.vendor || ':' || r.vendor_id END AS rid,\n  r.name,\n  j.next_run_at,\n  j.last_run_at,\n  w.created_at AS watch_created_at\nFROM selected sr\nJOIN availability_job j ON j.id = sr.job_id\nJOIN availability_watch w ON w.id = j.watch_id\nLEFT JOIN reservables r ON r.id = w.reservable_id;",
          "refId": "A"
        }
      ],
      "title": "Parent job & watch",
      "type": "table"
