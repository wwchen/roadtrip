{
  "name": "@roadtrip/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "generate": "drizzle-kit generate",
    "migrate": "npm run build && node dist/migrate.js"
  },
  "dependencies": {
    "@roadtrip/domain": "0.1.0",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "drizzle-kit": "0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
